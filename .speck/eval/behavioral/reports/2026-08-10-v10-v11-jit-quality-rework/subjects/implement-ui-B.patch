--- a/web/app.js
+++ b/web/app.js
@@ -1,3 +1,101 @@
-function initialState(items) { throw new Error('not implemented'); }
-function toggleSelection(state, id) { throw new Error('not implemented'); }
-function approveSelected(state) { throw new Error('not implemented'); }
+function initialState(items) {
+  const ids = new Set();
+
+  return {
+    items: items.map((item) => {
+      if (ids.has(item.id)) {
+        throw new Error(`Duplicate item id: ${item.id}`);
+      }
+
+      ids.add(item.id);
+      return { ...item, status: 'pending', selected: false };
+    }),
+  };
+}
+
+function toggleSelection(state, id) {
+  const item = state.items.find((candidate) => candidate.id === id);
+
+  if (!item) {
+    return state;
+  }
+
+  return {
+    ...state,
+    items: state.items.map((candidate) => (
+      candidate.id === id
+        ? { ...candidate, selected: !candidate.selected }
+        : candidate
+    )),
+  };
+}
+
+function approveSelected(state) {
+  if (!state.items.some((item) => item.selected)) {
+    return state;
+  }
+
+  return {
+    ...state,
+    items: state.items.map((item) => ({
+      ...item,
+      status: item.selected ? 'confirmed' : item.status,
+      selected: false,
+    })),
+  };
+}
+
+function renderReview(state, mount, approveButton) {
+  mount.replaceChildren();
+
+  state.items.forEach((item) => {
+    const control = document.createElement('button');
+    control.type = 'button';
+    control.dataset.itemId = item.id;
+    control.setAttribute('aria-pressed', String(item.selected));
+    control.textContent = `${item.label || item.id} (${item.status})`;
+    mount.append(control);
+  });
+
+  approveButton.disabled = !state.items.some((item) => item.selected);
+}
+
+function mountReview(items) {
+  const mount = document.getElementById('review');
+  const approveButton = document.getElementById('approve');
+
+  if (!mount || !approveButton) {
+    return;
+  }
+
+  let state = initialState(items);
+  const render = () => renderReview(state, mount, approveButton);
+
+  mount.addEventListener('click', (event) => {
+    const control = event.target.closest('button[data-item-id]');
+    if (!control || !mount.contains(control)) {
+      return;
+    }
+
+    state = toggleSelection(state, control.dataset.itemId);
+    render();
+  });
+
+  approveButton.addEventListener('click', () => {
+    state = approveSelected(state);
+    render();
+  });
+
+  render();
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { initialState, toggleSelection, approveSelected };
+}
+
+if (typeof document !== 'undefined') {
+  mountReview([
+    { id: 'draft', label: 'Draft' },
+    { id: 'budget', label: 'Budget' },
+  ]);
+}
diff --git a/web/app.test.js b/web/app.test.js
new file mode 100644
index 0000000..cb1bf10
--- /dev/null
+++ b/web/app.test.js
@@ -0,0 +1,59 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const {
+  initialState,
+  toggleSelection,
+  approveSelected,
+} = require('./app.js');
+
+test('initialState makes every item pending and unselected without mutating input', () => {
+  const items = [{ id: 'a', label: 'Draft', status: 'confirmed' }];
+
+  const state = initialState(items);
+
+  assert.deepEqual(state, {
+    items: [{ id: 'a', label: 'Draft', status: 'pending', selected: false }],
+  });
+  assert.deepEqual(items, [{ id: 'a', label: 'Draft', status: 'confirmed' }]);
+  assert.notEqual(state.items[0], items[0]);
+});
+
+test('initialState rejects duplicate item ids', () => {
+  assert.throws(
+    () => initialState([{ id: 'a' }, { id: 'a' }]),
+    /Duplicate item id: a/,
+  );
+});
+
+test('toggleSelection changes only the matching item and unknown ids preserve state identity', () => {
+  const state = initialState([{ id: 'a' }, { id: 'b' }]);
+
+  const selected = toggleSelection(state, 'b');
+
+  assert.equal(selected.items[0], state.items[0]);
+  assert.equal(selected.items[1].selected, true);
+  assert.equal(toggleSelection(state, 'missing'), state);
+  assert.equal(state.items[1].selected, false);
+});
+
+test('approveSelected confirms selected items, preserves unselected status, and clears selection', () => {
+  const initial = initialState([{ id: 'a' }, { id: 'b', status: 'ignored' }]);
+  const state = {
+    items: [
+      { ...initial.items[0], selected: true },
+      { ...initial.items[1], status: 'in_review', selected: false },
+    ],
+  };
+
+  const approved = approveSelected(state);
+
+  assert.deepEqual(approved, {
+    items: [
+      { id: 'a', status: 'confirmed', selected: false },
+      { id: 'b', status: 'in_review', selected: false },
+    ],
+  });
+  assert.deepEqual(state.items[0], { id: 'a', status: 'pending', selected: true });
+  assert.equal(approveSelected(initial), initial);
+});
