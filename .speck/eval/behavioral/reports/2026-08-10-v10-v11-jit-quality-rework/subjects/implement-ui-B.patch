+const fs = require('node:fs');
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const vm = require('node:vm');
+
+function createElement() {
+  return {
+    attributes: {},
+    dataset: {},
+    setAttribute(name, value) {
+      this.attributes[name] = value;
+    },
+  };
+}
+
+test('review controls reflect selection state and approval remains explicit', () => {
+  const review = {
+    children: [],
+    listeners: {},
+    addEventListener(type, handler) {
+      this.listeners[type] = handler;
+    },
+    append(child) {
+      this.children.push(child);
+    },
+    contains(child) {
+      return this.children.includes(child);
+    },
+    replaceChildren() {
+      this.children = [];
+    },
+  };
+  const approve = {
+    listeners: {},
+    addEventListener(type, handler) {
+      this.listeners[type] = handler;
+    },
+  };
+  const document = {
+    createElement,
+    getElementById(id) {
+      return id === 'review' ? review : approve;
+    },
+  };
+
+  vm.runInNewContext(fs.readFileSync(`${__dirname}/app.js`, 'utf8'), { document });
+
+  assert.equal(approve.disabled, true);
+  assert.deepEqual(review.children.map((button) => button.attributes['aria-pressed']), ['false', 'false']);
+
+  const selected = review.children[0];
+  selected.closest = () => selected;
+  review.listeners.click({ target: selected });
+
+  assert.equal(approve.disabled, false);
+  assert.equal(review.children[0].attributes['aria-pressed'], 'true');
+  assert.match(review.children[0].textContent, /pending/);
+
+  approve.listeners.click();
+
+  assert.equal(approve.disabled, true);
+  assert.equal(review.children[0].attributes['aria-pressed'], 'false');
+  assert.match(review.children[0].textContent, /confirmed/);
+});
