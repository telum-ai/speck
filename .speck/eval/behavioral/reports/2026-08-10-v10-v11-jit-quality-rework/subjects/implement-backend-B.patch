@@ -0,0 +1,77 @@
+from copy import deepcopy
+from datetime import datetime, timezone
+from pathlib import Path
+import sys
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from reminders import build_reminder
+
+
+NOW = datetime(2026, 8, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def action(*, due_at="2026-08-12T12:00:00Z", **overrides):
+    value = {
+        "confirmed": True,
+        "id": "action-7",
+        "owner": "kjetil",
+        "due_at": due_at,
+    }
+    value.update(overrides)
+    return value
+
+
+@pytest.mark.parametrize("confirmed", [False, None, 1, "true", []])
+def test_build_reminder_returns_none_unless_confirmed_is_true(confirmed):
+    assert build_reminder(action(confirmed=confirmed), NOW) is None
+
+
+@pytest.mark.parametrize(
+    "overrides",
+    [
+        {"id": ""},
+        {"owner": ""},
+        {"due_at": "not-a-date"},
+        {"due_at": "2026-08-12T12:00:00"},
+        {"due_at": "2026-08-12T12:00:00+02:00"},
+    ],
+)
+def test_build_reminder_rejects_invalid_confirmed_actions(overrides):
+    with pytest.raises(ValueError):
+        build_reminder(action(**overrides), NOW)
+
+
+def test_build_reminder_schedules_twenty_four_hours_before_due_at():
+    result = build_reminder(action(), NOW)
+
+    assert result == {
+        "id": "reminder:action-7:2026-08-12T12:00:00Z",
+        "action_id": "action-7",
+        "owner": "kjetil",
+        "due_at": "2026-08-12T12:00:00Z",
+        "remind_at": "2026-08-11T12:00:00Z",
+    }
+
+
+def test_build_reminder_uses_five_minute_fallback_only_when_before_due_at():
+    assert build_reminder(action(due_at="2026-08-10T12:06:00Z"), NOW)["remind_at"] == "2026-08-10T12:05:00Z"
+    assert build_reminder(action(due_at="2026-08-10T12:05:00Z"), NOW) is None
+
+
+def test_build_reminder_returns_none_for_elapsed_deadline_and_does_not_mutate_input():
+    original = action(due_at="2026-08-10T12:00:00Z")
+    before = deepcopy(original)
+
+    assert build_reminder(original, NOW) is None
+    assert original == before
+
+
+def test_build_reminder_is_deterministic_and_preserves_input():
+    original = action()
+    before = deepcopy(original)
+
+    assert build_reminder(original, NOW) == build_reminder(original, NOW)
+    assert original == before
