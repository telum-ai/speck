 """Reminder construction."""
 
+from datetime import datetime, timedelta, timezone
+from typing import Mapping
 
-def build_reminder(action, now):
-    raise NotImplementedError
+
+def _parse_utc_timestamp(value: object) -> datetime:
+    """Return an aware UTC datetime from an ISO-8601 UTC timestamp."""
+    if not isinstance(value, str) or not value:
+        raise ValueError("due_at must be a non-empty ISO-8601 UTC timestamp")
+
+    try:
+        parsed = datetime.fromisoformat(
+            f"{value[:-1]}+00:00" if value.endswith("Z") else value
+        )
+    except ValueError as error:
+        raise ValueError("due_at must be an ISO-8601 UTC timestamp") from error
+
+    if parsed.tzinfo is None or parsed.utcoffset() != timedelta(0):
+        raise ValueError("due_at must be an ISO-8601 UTC timestamp")
+
+    return parsed.astimezone(timezone.utc)
+
+
+def _format_utc(timestamp: datetime) -> str:
+    """Format an aware timestamp with the required UTC ``Z`` designator."""
+    return timestamp.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def _normalize_now(now: datetime) -> datetime:
+    if not isinstance(now, datetime) or now.tzinfo is None:
+        raise ValueError("now must be an aware datetime")
+    return now.astimezone(timezone.utc)
+
+
+def build_reminder(action: Mapping[str, object], now: datetime):
+    """Build a reminder payload for a confirmed action, or return ``None``.
+
+    The function is pure: it only reads the action mapping and returns a newly
+    constructed payload. Confirmed actions are validated before scheduling.
+    """
+    if not isinstance(action, Mapping) or action.get("confirmed") is not True:
+        return None
+
+    action_id = action.get("id")
+    owner = action.get("owner")
+    if not isinstance(action_id, str) or not action_id:
+        raise ValueError("confirmed action requires a non-empty id")
+    if not isinstance(owner, str) or not owner:
+        raise ValueError("confirmed action requires a non-empty owner")
+
+    due_at = _parse_utc_timestamp(action.get("due_at"))
+    now_utc = _normalize_now(now)
+    if due_at <= now_utc:
+        return None
+
+    remind_at = due_at - timedelta(hours=24)
+    if remind_at <= now_utc:
+        remind_at = now_utc + timedelta(minutes=5)
+        if remind_at >= due_at:
+            return None
+
+    due_at_text = _format_utc(due_at)
+    return {
+        "id": f"reminder:{action_id}:{due_at_text}",
+        "action_id": action_id,
+        "owner": owner,
+        "due_at": due_at_text,
+        "remind_at": _format_utc(remind_at),
+    }
