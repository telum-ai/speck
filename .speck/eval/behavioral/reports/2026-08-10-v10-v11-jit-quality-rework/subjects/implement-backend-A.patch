@@ -0,0 +1,67 @@
+"""Tests for reminder construction."""
+
+from datetime import datetime, timedelta, timezone
+import unittest
+
+from src.reminders import build_reminder
+
+
+UTC = timezone.utc
+NOW = datetime(2026, 8, 10, 12, 0, tzinfo=UTC)
+
+
+class BuildReminderTests(unittest.TestCase):
+    def test_unconfirmed_actions_are_ignored_without_validation(self):
+        self.assertIsNone(build_reminder({"confirmed": False}, NOW))
+        self.assertIsNone(build_reminder({"confirmed": 1}, NOW))
+
+    def test_confirmed_action_requires_id_owner_and_utc_due_at(self):
+        base = {"confirmed": True, "id": "a-1", "owner": "Kjetil", "due_at": "2026-08-12T12:00:00Z"}
+        for key in ("id", "owner", "due_at"):
+            invalid = dict(base)
+            invalid[key] = ""
+            with self.subTest(key=key):
+                with self.assertRaises(ValueError):
+                    build_reminder(invalid, NOW)
+
+        for due_at in ("not-a-date", "2026-08-12T12:00:00", "2026-08-12T12:00:00+01:00"):
+            invalid = dict(base, due_at=due_at)
+            with self.subTest(due_at=due_at):
+                with self.assertRaises(ValueError):
+                    build_reminder(invalid, NOW)
+
+    def test_schedules_a_day_before_and_normalizes_timestamps_to_z(self):
