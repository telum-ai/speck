@@ -0,0 +1,67 @@
+"""Contract tests for reminder construction."""
+
+from copy import deepcopy
+from datetime import datetime, timezone
+import unittest
+
+from src.reminders import build_reminder
+
+
+class BuildReminderTests(unittest.TestCase):
+    def setUp(self):
+        self.now = datetime(2026, 8, 10, 12, 0, tzinfo=timezone.utc)
+        self.action = {
+            "id": "action-7",
+            "owner": "Kjetil",
+            "confirmed": True,
+            "due_at": "2026-08-12T12:00:00Z",
+        }
+
+    def test_unconfirmed_actions_are_ignored_without_validation(self):
+        self.assertIsNone(build_reminder({"confirmed": 1}, self.now))
+        self.assertIsNone(build_reminder(None, self.now))
+
+    def test_confirmed_action_requires_id_owner_and_utc_due_at(self):
+        for invalid_action in (
+            {**self.action, "id": ""},
+            {**self.action, "owner": "  "},
+            {**self.action, "due_at": "2026-08-12T12:00:00"},
+            {**self.action, "due_at": "2026-08-12T14:00:00+02:00"},
+        ):
+            with self.subTest(action=invalid_action):
+                with self.assertRaises(ValueError):
+                    build_reminder(invalid_action, self.now)
+
+    def test_schedules_twenty_four_hours_before_due_time_without_mutating_input(self):
+        original = deepcopy(self.action)
+
+        reminder = build_reminder(self.action, self.now)
+
+        self.assertEqual(self.action, original)
+        self.assertEqual(
+            reminder,
+            {
+                "id": "reminder:action-7:2026-08-12T12:00:00Z",
+                "action_id": "action-7",
+                "owner": "Kjetil",
+                "due_at": "2026-08-12T12:00:00Z",
+                "remind_at": "2026-08-11T12:00:00Z",
+            },
+        )
+
+    def test_falls_back_to_five_minutes_after_now_only_when_before_due(self):
+        action = {**self.action, "due_at": "2026-08-10T12:06:00Z"}
+        self.assertEqual(
+            build_reminder(action, "2026-08-10T12:00:00Z")["remind_at"],
+            "2026-08-10T12:05:00Z",
+        )
+        self.assertIsNone(build_reminder({**action, "due_at": "2026-08-10T12:05:00Z"}, self.now))
+
+    def test_due_at_must_be_future_and_twenty_four_hour_boundary_is_kept(self):
+        self.assertIsNone(build_reminder({**self.action, "due_at": "2026-08-10T12:00:00Z"}, self.now))
+        reminder = build_reminder({**self.action, "due_at": "2026-08-11T12:00:00Z"}, self.now)
+        self.assertEqual(reminder["remind_at"], "2026-08-10T12:00:00Z")
+
+
+if __name__ == "__main__":
+    unittest.main()
