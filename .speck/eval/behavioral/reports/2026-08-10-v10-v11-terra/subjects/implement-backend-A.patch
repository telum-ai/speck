 """Reminder construction."""
 
+from collections.abc import Mapping
+from datetime import datetime, timedelta, timezone
+
+
+def _parse_utc_timestamp(value, field_name):
+    """Return a UTC datetime for an ISO-8601 timestamp with an explicit offset."""
+    if not isinstance(value, str) or not value:
+        raise ValueError(f"{field_name} must be an ISO-8601 UTC timestamp")
+
+    try:
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError as error:
+        raise ValueError(f"{field_name} must be an ISO-8601 UTC timestamp") from error
+
+    if parsed.tzinfo is None or parsed.utcoffset() != timedelta(0):
+        raise ValueError(f"{field_name} must be an ISO-8601 UTC timestamp")
+
+    return parsed.astimezone(timezone.utc)
+
+
+def _format_utc_timestamp(value):
+    """Render a UTC datetime in the wire format required by reminders."""
+    return value.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
 
 def build_reminder(action, now):
-    raise NotImplementedError
+    """Build one deterministic reminder for a confirmed action, or ``None``.
+
+    ``action`` is deliberately read without mutation so callers can safely reuse it.
+    """
+    if not isinstance(action, Mapping) or action.get("confirmed") is not True:
+        return None
+
+    action_id = action.get("id")
+    owner = action.get("owner")
+    if not isinstance(action_id, str) or not action_id.strip():
+        raise ValueError("confirmed action requires a non-empty id")
+    if not isinstance(owner, str) or not owner.strip():
+        raise ValueError("confirmed action requires a non-empty owner")
+
+    due_at = _parse_utc_timestamp(action.get("due_at"), "due_at")
+    current_time = _parse_utc_timestamp(now, "now") if isinstance(now, str) else now
+    if not isinstance(current_time, datetime) or current_time.tzinfo is None:
+        raise ValueError("now must be an aware datetime or ISO-8601 UTC timestamp")
+    if current_time.utcoffset() != timedelta(0):
+        raise ValueError("now must be in UTC")
+    current_time = current_time.astimezone(timezone.utc)
+
+    if due_at <= current_time:
+        return None
+
+    remind_at = due_at - timedelta(hours=24)
+    if remind_at < current_time:
+        remind_at = current_time + timedelta(minutes=5)
+        if remind_at >= due_at:
+            return None
+
+    due_at_text = _format_utc_timestamp(due_at)
+    return {
+        "id": f"reminder:{action_id}:{due_at_text}",
+        "action_id": action_id,
+        "owner": owner,
+        "due_at": due_at_text,
+        "remind_at": _format_utc_timestamp(remind_at),
+    }
