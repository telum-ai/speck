+contract_version: 1
+name: provider-retry-quota
+kind: internal-service-contract
+purpose: >-
+  Define the idempotent commands between reminder retry dispatch, provider outcome
+  handling, cancellation/timeout handling, and quota accounting. This is not a
+  public HTTP API contract.
+
+types:
+  ReservationState:
+    type: string
+    enum: [reserved, finalized, restored]
+  RestoreReason:
+    type: string
+    enum: [provider_failed, provider_timed_out, cancelled]
+  StartRetryCommand:
+    type: object
+    required: [retry_attempt_id, workspace_id]
+    properties:
+      retry_attempt_id:
+        type: string
+        description: Stable idempotency key for one retry attempt.
+      workspace_id:
+        type: string
+        description: Derived from the authenticated retry attempt at the service boundary.
+      provider_delivery_id:
+        type: string
+        nullable: true
+        description: Optional provider correlation identifier when known before dispatch.
+  ReservationResult:
+    type: object
+    required: [retry_attempt_id, status]
+    properties:
+      retry_attempt_id:
+        type: string
+      reservation_id:
+        type: string
+        nullable: true
+      status:
+        type: string
+        enum: [reserved, quota_exhausted]
+      state:
+        $ref: '#/types/ReservationState'
+        nullable: true
+  ProviderOutcomeCommand:
+    type: object
+    required: [retry_attempt_id, outcome, callback_idempotency_key]
+    properties:
+      retry_attempt_id:
+        type: string
+      provider_delivery_id:
+        type: string
+        nullable: true
+      outcome:
+        type: string
+        enum: [accepted, failed, timed_out]
+      callback_idempotency_key:
+        type: string
+        description: Stable key for a provider callback delivery after provider authentication.
+  CancelRetryCommand:
+    type: object
+    required: [retry_attempt_id, cancellation_idempotency_key]
+    properties:
+      retry_attempt_id:
+        type: string
+      cancellation_idempotency_key:
+        type: string
+  TerminalResult:
+    type: object
+    required: [retry_attempt_id, state, applied]
+    properties:
+      retry_attempt_id:
+        type: string
+      state:
+        $ref: '#/types/ReservationState'
+      applied:
+        type: boolean
+        description: True only when this command performed the first terminal transition.
+      restore_reason:
+        $ref: '#/types/RestoreReason'
+        nullable: true
+
+operations:
+  start_retry:
+    input:
+      $ref: '#/types/StartRetryCommand'
+    output:
+      $ref: '#/types/ReservationResult'
+    guarantees:
+      - The result is idempotent by retry_attempt_id.
+      - A reserved result means one credit was atomically debited and one reservation exists.
+      - A quota_exhausted result means no credit was debited and the provider must not be called.
+  record_provider_outcome:
+    input:
+      $ref: '#/types/ProviderOutcomeCommand'
+    output:
+      $ref: '#/types/TerminalResult'
+    guarantees:
+      - accepted transitions reserved to finalized exactly once and never changes quota.
+      - failed and timed_out transition reserved to restored exactly once and atomically re-credit quota.
+      - Repeated or late callbacks return the stored terminal state with applied false.
+      - Unknown or mismatched provider correlation returns an error/audit event and does not mutate quota.
+  cancel_retry:
+    input:
+      $ref: '#/types/CancelRetryCommand'
+    output:
+      $ref: '#/types/TerminalResult'
+    guarantees:
+      - Cancellation transitions reserved to restored exactly once and atomically re-credits quota.
+      - Repeated cancellation or cancellation after a terminal provider outcome is a no-op with the stored state.
+
+errors:
+  quota_exhausted:
+    retryable: true
+    mutation: none
+  unknown_retry_attempt:
+    retryable: false
+    mutation: none
+  invalid_provider_callback:
+    retryable: false
+    mutation: none
+  correlation_mismatch:
+    retryable: false
+    mutation: none
