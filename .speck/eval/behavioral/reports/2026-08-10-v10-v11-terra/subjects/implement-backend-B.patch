@@ -0,0 +1,86 @@
+from datetime import datetime, timezone
+import unittest
+
+from src.reminders import build_reminder
+
+
+NOW = datetime(2026, 8, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def confirmed_action(**overrides):
+    action = {
+        "id": "action-1",
+        "owner": "Kjetil",
+        "confirmed": True,
+        "due_at": "2026-08-12T12:00:00Z",
+    }
+    action.update(overrides)
+    return action
+
+
+class BuildReminderTests(unittest.TestCase):
+    def test_unconfirmed_actions_do_not_require_valid_fields_or_emit_a_reminder(self):
+        self.assertIsNone(build_reminder({"confirmed": False}, NOW))
+        self.assertIsNone(build_reminder({"confirmed": 1}, NOW))
+
+    def test_confirmed_actions_require_complete_utc_input(self):
+        for overrides in (
+            {"id": ""},
+            {"id": "   "},
+            {"owner": ""},
+            {"owner": "   "},
+            {"due_at": "not-a-date"},
+            {"due_at": "2026-08-12T12:00:00"},
+            {"due_at": "2026-08-12T12:00:00+01:00"},
+            {"due_at": "2026-08-12T12:00:00+02:00"},
+        ):
+            with self.subTest(overrides=overrides):
+                with self.assertRaises(ValueError):
+                    build_reminder(confirmed_action(**overrides), NOW)
+
+    def test_schedules_one_day_before_due_and_does_not_mutate_input(self):
+        action = confirmed_action()
+
+        reminder = build_reminder(action, NOW)
+
+        self.assertEqual(
+            reminder,
+            {
+                "id": "reminder:action-1:2026-08-12T12:00:00Z",
+                "action_id": "action-1",
+                "owner": "Kjetil",
+                "due_at": "2026-08-12T12:00:00Z",
+                "remind_at": "2026-08-11T12:00:00Z",
+            },
+        )
+        self.assertEqual(action, confirmed_action())
+
+    def test_accepts_zero_utc_offset_and_normalizes_emitted_timestamps_to_z(self):
+        reminder = build_reminder(
+            confirmed_action(due_at="2026-08-12T12:00:00+00:00"), NOW
+        )
+
+        self.assertEqual(reminder["due_at"], "2026-08-12T12:00:00Z")
+        self.assertEqual(reminder["remind_at"], "2026-08-11T12:00:00Z")
+
+    def test_due_actions_are_not_scheduled(self):
+        for due_at in ("2026-08-10T12:00:00Z", "2026-08-10T11:59:59Z"):
+            with self.subTest(due_at=due_at):
+                self.assertIsNone(build_reminder(confirmed_action(due_at=due_at), NOW))
+
+    def test_uses_the_normal_schedule_when_it_is_exactly_now(self):
+        reminder = build_reminder(
+            confirmed_action(due_at="2026-08-11T12:00:00Z"), NOW
+        )
+
+        self.assertEqual(reminder["remind_at"], "2026-08-10T12:00:00Z")
+
+    def test_uses_a_five_minute_fallback_only_when_strictly_before_due(self):
+        action = confirmed_action(due_at="2026-08-10T12:06:00Z")
+
+        self.assertEqual(
+            build_reminder(action, NOW)["remind_at"], "2026-08-10T12:05:00Z"
+        )
+        self.assertIsNone(
+            build_reminder(confirmed_action(due_at="2026-08-10T12:05:00Z"), NOW)
+        )
