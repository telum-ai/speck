-"""Reminder construction."""
+"""Pure construction of reminders for confirmed actions."""
+
+from datetime import datetime, timedelta, timezone
+from collections.abc import Mapping
+
+
+def _as_utc(value, field_name):
+    """Parse a UTC ISO-8601 timestamp without accepting a local time."""
+    if isinstance(value, datetime):
+        timestamp = value
+    elif isinstance(value, str):
+        try:
+            timestamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
+        except ValueError as error:
+            raise ValueError(f"{field_name} must be an ISO-8601 UTC timestamp") from error
+    else:
+        raise ValueError(f"{field_name} must be an ISO-8601 UTC timestamp")
+
+    if timestamp.tzinfo is None or timestamp.utcoffset() != timedelta(0):
+        raise ValueError(f"{field_name} must be an ISO-8601 UTC timestamp")
+
+    return timestamp.astimezone(timezone.utc)
+
+
+def _format_utc(timestamp):
+    return timestamp.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
 
 
 def build_reminder(action, now):
-    raise NotImplementedError
+    """Return the deterministic reminder payload for a confirmed action.
+
+    Invalid data matters only after confirmation: incomplete unconfirmed actions
+    deliberately produce no reminder.
+    """
+    if not isinstance(action, Mapping) or action.get("confirmed") is not True:
+        return None
+
+    action_id = action.get("id")
+    owner = action.get("owner")
+    if not isinstance(action_id, str) or not action_id.strip():
+        raise ValueError("confirmed actions require a non-empty id")
+    if not isinstance(owner, str) or not owner.strip():
+        raise ValueError("confirmed actions require a non-empty owner")
+
+    due = _as_utc(action.get("due_at"), "due_at")
+    current_time = _as_utc(now, "now")
+    if due <= current_time:
+        return None
+
+    remind_at = due - timedelta(hours=24)
+    if remind_at < current_time:
+        remind_at = current_time + timedelta(minutes=5)
+        if remind_at >= due:
+            return None
+
+    due_at = _format_utc(due)
+    return {
+        "id": f"reminder:{action_id}:{due_at}",
+        "action_id": action_id,
+        "owner": owner,
+        "due_at": due_at,
+        "remind_at": _format_utc(remind_at),
+    }
