diff --git a/web/app.test.cjs b/web/app.test.cjs
new file mode 100644
index 0000000..c7dc494
--- /dev/null
+++ b/web/app.test.cjs
@@ -0,0 +1,54 @@
+const assert = require('node:assert/strict');
+const test = require('node:test');
+
+const { initialState, toggleSelection, approveSelected } = require('./app.js');
+
+const sourceItems = [
+  { id: 'alpha', label: 'Alpha' },
+  { id: 'beta', label: 'Beta' },
+];
+
+test('initialState makes fresh pending, unselected review state without mutating inputs', () => {
+  const state = initialState(sourceItems);
+  assert.deepEqual(state, {
+    items: [
+      { id: 'alpha', label: 'Alpha', status: 'pending' },
+      { id: 'beta', label: 'Beta', status: 'pending' },
+    ],
+    selectedIds: [],
+  });
+  assert.deepEqual(sourceItems, [
+    { id: 'alpha', label: 'Alpha' },
+    { id: 'beta', label: 'Beta' },
+  ]);
+  assert.notStrictEqual(state.items, sourceItems);
+});
+
+test('initialState rejects duplicate ids', () => {
+  assert.throws(() => initialState([{ id: 'same' }, { id: 'same' }]), /duplicate item id: same/i);
+});
+
+test('toggleSelection changes only a matching pending id and unknown ids are no-ops', () => {
+  const state = initialState(sourceItems);
+  const selected = toggleSelection(state, 'alpha');
+  assert.deepEqual(selected.selectedIds, ['alpha']);
+  assert.deepEqual(selected.items, state.items);
+  assert.notStrictEqual(selected, state);
+  assert.strictEqual(toggleSelection(selected, 'missing'), selected);
+  assert.deepEqual(toggleSelection(selected, 'alpha').selectedIds, []);
+});
+
+test('approveSelected confirms selected items, clears selection, and no-ops when empty', () => {
+  const state = initialState(sourceItems);
+  assert.strictEqual(approveSelected(state), state);
+  const selected = toggleSelection(state, 'beta');
+  const approved = approveSelected(selected);
+  assert.deepEqual(approved, {
+    items: [
+      { id: 'alpha', label: 'Alpha', status: 'pending' },
+      { id: 'beta', label: 'Beta', status: 'confirmed' },
+    ],
+    selectedIds: [],
+  });
+  assert.deepEqual(selected.items[1], { id: 'beta', label: 'Beta', status: 'pending' });
+});
