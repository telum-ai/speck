-function initialState(items) { throw new Error('not implemented'); }
-function toggleSelection(state, id) { throw new Error('not implemented'); }
-function approveSelected(state) { throw new Error('not implemented'); }
+(function reviewModule(global) {
+  'use strict';
+
+  function assertUniqueItems(items) {
+    if (!Array.isArray(items)) {
+      throw new TypeError('items must be an array');
+    }
+
+    const ids = new Set();
+    for (const item of items) {
+      if (!item || typeof item.id !== 'string' || item.id.length === 0) {
+        throw new TypeError('each item must have a non-empty string id');
+      }
+      if (ids.has(item.id)) {
+        throw new Error(`duplicate item id: ${item.id}`);
+      }
+      ids.add(item.id);
+    }
+  }
+
+  function initialState(items) {
+    assertUniqueItems(items);
+    return {
+      items: items.map((item) => ({ ...item, status: 'pending' })),
+      selectedIds: [],
+    };
+  }
+
+  function toggleSelection(state, id) {
+    if (!state.items.some((item) => item.id === id)) {
+      return state;
+    }
+
+    const selected = new Set(state.selectedIds);
+    if (selected.has(id)) {
+      selected.delete(id);
+    } else {
+      selected.add(id);
+    }
+
+    return { ...state, selectedIds: [...selected] };
+  }
+
+  function approveSelected(state) {
+    if (state.selectedIds.length === 0) {
+      return state;
+    }
+
+    const selected = new Set(state.selectedIds);
+    return {
+      ...state,
+      items: state.items.map((item) => (
+        selected.has(item.id) ? { ...item, status: 'confirmed' } : item
+      )),
+      selectedIds: [],
+    };
+  }
+
+  function startReview() {
+    const review = document.getElementById('review');
+    const approve = document.getElementById('approve');
+    const status = document.getElementById('review-status');
+    if (!review || !approve) return;
+
+    let state = initialState([
+      { id: 'brief', label: 'Quarterly planning brief' },
+      { id: 'research', label: 'Customer research synthesis' },
+      { id: 'launch', label: 'Launch readiness checklist' },
+    ]);
+
+    function render() {
+      review.replaceChildren();
+      const pendingCount = state.items.filter((item) => item.status === 'pending').length;
+      const selected = new Set(state.selectedIds);
+
+      state.items.forEach((item) => {
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.className = `review-item review-item--${item.status}`;
+        button.dataset.itemId = item.id;
+        button.disabled = item.status === 'confirmed';
+        button.setAttribute('aria-pressed', String(selected.has(item.id)));
+        button.setAttribute('aria-label', `${item.label}: ${item.status}`);
+
+        const label = document.createElement('span');
+        label.className = 'review-item__label';
+        label.textContent = item.label;
+        button.append(label);
+
+        const stateLabel = document.createElement('span');
+        stateLabel.className = 'review-item__state';
+        stateLabel.textContent = item.status === 'confirmed'
+          ? 'Confirmed'
+          : selected.has(item.id) ? 'Selected' : 'Pending';
+        button.append(stateLabel);
+        review.append(button);
+      });
+
+      approve.disabled = state.selectedIds.length === 0;
+      approve.textContent = state.selectedIds.length === 0
+        ? 'Approve selected'
+        : `Approve ${state.selectedIds.length} selected`;
+      review.setAttribute('aria-label', `${pendingCount} pending items`);
+    }
+
+    review.addEventListener('click', (event) => {
+      const button = event.target.closest('button[data-item-id]');
+      if (!button || button.disabled) return;
+      state = toggleSelection(state, button.dataset.itemId);
+      render();
+    });
+
+    approve.addEventListener('click', () => {
+      if (state.selectedIds.length === 0) return;
+      const count = state.selectedIds.length;
+      state = approveSelected(state);
