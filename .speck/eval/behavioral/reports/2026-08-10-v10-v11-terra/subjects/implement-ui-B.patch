diff --git a/web/app.js b/web/app.js
index 0dda12b..b1b2ff4 100644
--- a/web/app.js
+++ b/web/app.js
@@ -1,3 +1,96 @@
-function initialState(items) { throw new Error('not implemented'); }
-function toggleSelection(state, id) { throw new Error('not implemented'); }
-function approveSelected(state) { throw new Error('not implemented'); }
+function initialState(items) {
+  if (!Array.isArray(items)) {
+    throw new TypeError('items must be an array');
+  }
+
+  const ids = new Set();
+  const normalizedItems = items.map((item) => {
+    if (ids.has(item.id)) {
+      throw new Error(`Duplicate item id: ${item.id}`);
+    }
+    ids.add(item.id);
+    return { ...item, status: 'pending', selected: false };
+  });
+
+  return { items: normalizedItems };
+}
+
+function toggleSelection(state, id) {
+  const item = state.items.find((candidate) => candidate.id === id);
+  if (!item || item.status !== 'pending') {
+    return state;
+  }
+
+  return {
+    ...state,
+    items: state.items.map((candidate) => (
+      candidate.id === id ? { ...candidate, selected: !candidate.selected } : candidate
+    )),
+  };
+}
+
+function approveSelected(state) {
+  if (!state.items.some((item) => item.selected)) {
+    return state;
+  }
+
+  return {
+    ...state,
+    items: state.items.map((item) => (
+      item.selected
+        ? { ...item, status: 'confirmed', selected: false }
+        : item
+    )),
+  };
+}
+
+function mountReview() {
+  const review = document.querySelector('#review');
+  const approve = document.querySelector('#approve');
+  if (!review || !approve) {
+    return;
+  }
+
+  let state = initialState(Array.isArray(window.reviewItems) ? window.reviewItems : []);
+
+  function render() {
+    review.replaceChildren();
+    if (state.items.length === 0) {
+      const empty = document.createElement('p');
+      empty.textContent = 'No items to review.';
+      review.append(empty);
+    }
+
+    for (const item of state.items) {
+      const control = document.createElement('button');
+      control.type = 'button';
+      control.dataset.reviewId = String(item.id);
+      control.disabled = item.status === 'confirmed';
+      control.setAttribute('aria-pressed', String(item.selected));
+      control.textContent = item.status === 'confirmed'
+        ? `${item.label || item.id} (confirmed)`
+        : item.label || String(item.id);
+      control.addEventListener('click', () => {
+        state = toggleSelection(state, item.id);
+        render();
+      });
+      review.append(control);
+    }
+
+    approve.disabled = !state.items.some((item) => item.selected);
+  }
+
+  approve.addEventListener('click', () => {
+    state = approveSelected(state);
+    render();
+  });
+  render();
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { initialState, toggleSelection, approveSelected };
+}
+
+if (typeof window !== 'undefined' && typeof document !== 'undefined') {
+  window.addEventListener('DOMContentLoaded', mountReview);
+}
diff --git a/web/app.test.mjs b/web/app.test.mjs
new file mode 100644
index 0000000..adf9398
--- /dev/null
+++ b/web/app.test.mjs
@@ -0,0 +1,70 @@
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import test from 'node:test';
+import vm from 'node:vm';
+
+const source = await readFile(new URL('./app.js', import.meta.url), 'utf8');
+const sandbox = { module: { exports: {} } };
+vm.runInNewContext(source, sandbox);
+const exported = sandbox.module.exports;
+
+const { initialState, toggleSelection, approveSelected } = exported;
+
+test('initialState creates pending unselected items without changing input', () => {
+  const items = [{ id: 'a', label: 'Alpha' }, { id: 'b', label: 'Beta' }];
+  const state = initialState(items);
+
+  assert.deepEqual(JSON.parse(JSON.stringify(state)), {
+    items: [
+      { id: 'a', label: 'Alpha', status: 'pending', selected: false },
+      { id: 'b', label: 'Beta', status: 'pending', selected: false },
+    ],
+  });
+  assert.deepEqual(items, [{ id: 'a', label: 'Alpha' }, { id: 'b', label: 'Beta' }]);
+  assert.notEqual(state.items, items);
+});
+
+test('initialState rejects duplicate ids', () => {
+  assert.throws(() => initialState([{ id: 'a' }, { id: 'a' }]), /Duplicate item id: a/);
+});
+
+test('toggleSelection changes only the matching pending item and leaves input intact', () => {
+  const state = initialState([{ id: 'a' }, { id: 'b' }]);
+  const next = toggleSelection(state, 'b');
+
+  assert.deepEqual(JSON.parse(JSON.stringify(next.items.map(({ id, selected }) => ({ id, selected })))), [
+    { id: 'a', selected: false },
+    { id: 'b', selected: true },
+  ]);
+  assert.equal(state.items[1].selected, false);
+  assert.notEqual(next, state);
+  assert.notEqual(next.items[1], state.items[1]);
+});
+
+test('toggleSelection returns the original state for unknown and confirmed ids', () => {
+  const state = initialState([{ id: 'a' }]);
+  const confirmed = approveSelected(toggleSelection(state, 'a'));
+
+  assert.equal(toggleSelection(state, 'missing'), state);
+  assert.equal(toggleSelection(confirmed, 'a'), confirmed);
+});
+
+test('approveSelected confirms only selected items, clears selection, and is immutable', () => {
+  const state = toggleSelection(initialState([{ id: 'a' }, { id: 'b' }]), 'a');
+  const next = approveSelected(state);
+  const nothingSelected = initialState([{ id: 'a' }]);
+
+  assert.deepEqual(JSON.parse(JSON.stringify(next.items.map(({ id, status, selected }) => ({ id, status, selected })))), [
+    { id: 'a', status: 'confirmed', selected: false },
+    { id: 'b', status: 'pending', selected: false },
+  ]);
+  assert.equal(state.items[0].status, 'pending');
+  assert.equal(state.items[0].selected, true);
+  assert.equal(approveSelected(nothingSelected), nothingSelected);
+});
+
+test('browser mounting derives accessible control state from the review state', () => {
+  assert.match(source, /control\.setAttribute\('aria-pressed', String\(item\.selected\)\)/);
+  assert.match(source, /approve\.disabled = !state\.items\.some\(\(item\) => item\.selected\)/);
+  assert.match(source, /control\.disabled = item\.status === 'confirmed'/);
+});
