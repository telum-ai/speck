+contract_version: "1.0"
+kind: internal-service
+name: retry-credit-reservation
+idempotency:
+  key: attempt_key
+  uniqueness_scope:
+    - workspace_id
+    - attempt_key
+reservation:
+  credit_amount: 1
+  states: [reserved, finalized, released]
+  transitions:
+    reserve: { from: new, to: reserved, balance_delta: -1, requires_available_credits: 1 }
+    finalize: { from: reserved, to: finalized, balance_delta: 0 }
+    release:
+      from: reserved
+      to: released
+      balance_delta: 1
+      reasons: [provider_failed, timed_out, cancelled]
+operations:
+  reserveRetryCredit:
+    input: [workspace_id, attempt_key]
+    replay: return_existing_reservation
+    quota_exhausted: no_provider_dispatch
+  finalizeRetryCredit:
+    input: [workspace_id, attempt_key, provider_correlation_id]
+    predicate: status_is_reserved
+  releaseRetryCredit:
+    input: [workspace_id, attempt_key, terminal_reason]
+    predicate: status_is_reserved
+  dispatchReminderRetry:
+    sequence: [reserveRetryCredit, provider_dispatch, finalizeRetryCredit_or_releaseRetryCredit]
+invariants:
+  - available_retry_credits_non_negative
+  - terminal_transition_is_exactly_once
+  - provider_io_outside_transaction
+  - callback_workspace_and_correlation_must_match
