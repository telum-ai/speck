 """Reminder construction."""
 
+from datetime import datetime, timedelta, timezone
+from typing import Any, Mapping
 
-def build_reminder(action, now):
-    raise NotImplementedError
+
+def _action_value(action: Any, field: str) -> Any:
+    """Return a field from either a mapping action or an action-like object."""
+    if isinstance(action, Mapping):
+        return action.get(field)
+    return getattr(action, field, None)
+
+
+def _parse_utc_timestamp(value: Any, field: str) -> datetime:
+    """Parse an ISO-8601 timestamp and require it to represent UTC."""
+    if isinstance(value, datetime):
+        timestamp = value
+    elif isinstance(value, str):
+        try:
+            timestamp = datetime.fromisoformat(
+                f"{value[:-1]}+00:00" if value.endswith("Z") else value
+            )
+        except ValueError as error:
+            raise ValueError(f"{field} must be an ISO-8601 UTC timestamp") from error
+    else:
+        raise ValueError(f"{field} must be an ISO-8601 UTC timestamp")
+
+    if timestamp.tzinfo is None or timestamp.utcoffset() != timedelta(0):
+        raise ValueError(f"{field} must be an ISO-8601 UTC timestamp")
+    return timestamp.astimezone(timezone.utc)
+
+
+def _format_utc(timestamp: datetime) -> str:
+    return timestamp.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
+
+def build_reminder(action: Any, now: Any) -> dict[str, str] | None:
+    """Build a deterministic reminder for a confirmed, future action.
+
+    The function is deliberately pure: it reads the action without changing it
+    and returns ``None`` for actions that do not warrant a future reminder.
+    """
+    if _action_value(action, "confirmed") is not True:
+        return None
+
+    action_id = _action_value(action, "id")
+    owner = _action_value(action, "owner")
+    due_at_value = _action_value(action, "due_at")
+    if not isinstance(action_id, str) or not action_id:
+        raise ValueError("confirmed action requires a non-empty id")
+    if not isinstance(owner, str) or not owner:
+        raise ValueError("confirmed action requires a non-empty owner")
+
+    due_at = _parse_utc_timestamp(due_at_value, "due_at")
+    current_time = _parse_utc_timestamp(now, "now")
+    if due_at <= current_time:
+        return None
+
+    remind_at = due_at - timedelta(hours=24)
+    if remind_at < current_time:
+        fallback = current_time + timedelta(minutes=5)
+        if fallback >= due_at:
+            return None
+        remind_at = fallback
+
+    due_at_text = _format_utc(due_at)
+    return {
+        "id": f"reminder:{action_id}:{due_at_text}",
+        "action_id": action_id,
+        "owner": owner,
+        "due_at": due_at_text,
+        "remind_at": _format_utc(remind_at),
+    }
