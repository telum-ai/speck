@@ -0,0 +1,74 @@
+"""Behaviour tests for reminder construction."""
+
+import copy
+import unittest
+
+from src.reminders import build_reminder
+
+
+class BuildReminderTests(unittest.TestCase):
+    now = "2026-08-10T12:00:00Z"
+
+    def test_unconfirmed_action_returns_none_without_validation(self):
+        self.assertIsNone(build_reminder({"confirmed": 1}, "not-a-timestamp"))
+
+    def test_confirmed_action_requires_id_owner_and_utc_due_at(self):
+        invalid_actions = (
+            {"confirmed": True, "owner": "Ada", "due_at": "2026-08-12T12:00:00Z"},
+            {"confirmed": True, "id": "a1", "due_at": "2026-08-12T12:00:00Z"},
+            {"confirmed": True, "id": "a1", "owner": "Ada", "due_at": "2026-08-12T12:00:00"},
+            {"confirmed": True, "id": "a1", "owner": "Ada", "due_at": "not-a-timestamp"},
+        )
+
+        for action in invalid_actions:
+            with self.subTest(action=action):
+                with self.assertRaises(ValueError):
+                    build_reminder(action, self.now)
+
+    def test_uses_the_normal_twenty_four_hour_schedule_without_mutating_input(self):
+        action = {
+            "confirmed": True,
+            "id": "a1",
+            "owner": "Ada",
+            "due_at": "2026-08-12T12:00:00+00:00",
+        }
+        original = copy.deepcopy(action)
+
+        reminder = build_reminder(action, self.now)
+
+        self.assertEqual(action, original)
+        self.assertEqual(
+            reminder,
+            {
+                "id": "reminder:a1:2026-08-12T12:00:00Z",
+                "action_id": "a1",
+                "owner": "Ada",
+                "due_at": "2026-08-12T12:00:00Z",
+                "remind_at": "2026-08-11T12:00:00Z",
+            },
+        )
+
+    def test_uses_five_minute_fallback_only_when_it_is_before_due_at(self):
+        action = {
+            "confirmed": True,
+            "id": "a1",
+            "owner": "Ada",
+            "due_at": "2026-08-10T12:06:00Z",
+        }
+
+        self.assertEqual(
+            build_reminder(action, self.now)["remind_at"], "2026-08-10T12:05:00Z"
+        )
+        action["due_at"] = "2026-08-10T12:05:00Z"
+        self.assertIsNone(build_reminder(action, self.now))
+
+    def test_past_or_current_due_at_returns_none(self):
+        action = {"confirmed": True, "id": "a1", "owner": "Ada"}
+        for due_at in ("2026-08-10T12:00:00Z", "2026-08-10T11:59:59Z"):
+            with self.subTest(due_at=due_at):
+                action["due_at"] = due_at
+                self.assertIsNone(build_reminder(action, self.now))
+
+
+if __name__ == "__main__":
+    unittest.main()
