+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const {
+  initialState,
+  toggleSelection,
+  approveSelected,
+} = require('./app.js');
+
+test('initialState copies items as pending and unselected without mutating input', () => {
+  const items = [{ id: 'one', label: 'First', status: 'confirmed', selected: true }];
+
+  const state = initialState(items);
+
+  assert.deepEqual(state, [{ id: 'one', label: 'First', status: 'pending', selected: false }]);
+  assert.deepEqual(items, [{ id: 'one', label: 'First', status: 'confirmed', selected: true }]);
+  assert.notEqual(state[0], items[0]);
+});
+
+test('initialState rejects duplicate IDs', () => {
+  assert.throws(() => initialState([{ id: 'one' }, { id: 'one' }]), /Duplicate item id: one/);
+});
+
+test('toggleSelection only changes a known item and preserves unknown state identity', () => {
+  const state = initialState([{ id: 'one' }, { id: 'two' }]);
+
+  const toggled = toggleSelection(state, 'two');
+
+  assert.deepEqual(toggled, [
+    { id: 'one', status: 'pending', selected: false },
+    { id: 'two', status: 'pending', selected: true },
+  ]);
+  assert.equal(toggleSelection(state, 'missing'), state);
+  assert.equal(state[1].selected, false);
+});
+
+test('approveSelected confirms only selected items and clears selection', () => {
+  const state = toggleSelection(initialState([{ id: 'one' }, { id: 'two' }]), 'one');
+
+  assert.deepEqual(approveSelected(state), [
+    { id: 'one', status: 'confirmed', selected: false },
+    { id: 'two', status: 'pending', selected: false },
+  ]);
+});
+
+test('approveSelected preserves state identity when nothing is selected', () => {
+  const state = initialState([{ id: 'one' }]);
+  assert.equal(approveSelected(state), state);
+});
