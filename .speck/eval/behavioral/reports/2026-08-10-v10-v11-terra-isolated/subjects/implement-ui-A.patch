-function approveSelected(state) { throw new Error('not implemented'); }
+function initialState(items) {
+  const seenIds = new Set();
+
+  return items.map((item) => {
+    if (seenIds.has(item.id)) {
+      throw new Error(`Duplicate item id: ${item.id}`);
+    }
+
+    seenIds.add(item.id);
+    return { ...item, status: 'pending', selected: false };
+  });
+}
+
+function toggleSelection(state, id) {
+  if (!state.some((item) => item.id === id)) {
+    return state;
+  }
+
+  return state.map((item) => (
+    item.id === id ? { ...item, selected: !item.selected } : item
+  ));
+}
+
+function approveSelected(state) {
+  if (!state.some((item) => item.selected)) {
+    return state;
+  }
+
+  return state.map((item) => (
+    item.selected
+      ? { ...item, status: 'confirmed', selected: false }
+      : item
+  ));
+}
+
+function renderReview(root, approveButton, status, state) {
+  root.replaceChildren();
+
+  state.forEach((item) => {
+    const button = document.createElement('button');
+    const isConfirmed = item.status === 'confirmed';
+
+    button.type = 'button';
+    button.className = `review-item${item.selected ? ' review-item--selected' : ''}${isConfirmed ? ' review-item--confirmed' : ''}`;
+    button.dataset.id = item.id;
+    button.setAttribute('aria-pressed', String(item.selected));
+    button.disabled = isConfirmed;
+    button.textContent = `${item.label || item.id} · ${isConfirmed ? 'Confirmed' : item.selected ? 'Selected' : 'Pending'}`;
+    root.append(button);
+  });
+
+  const selectedCount = state.filter((item) => item.selected).length;
+  approveButton.disabled = selectedCount === 0;
+  status.textContent = selectedCount === 0
+    ? 'Select pending items to approve.'
+    : `${selectedCount} item${selectedCount === 1 ? '' : 's'} selected.`;
+}
+
+if (typeof document !== 'undefined') {
+  const root = document.querySelector('#review');
+  const approveButton = document.querySelector('#approve');
+  const status = document.querySelector('#review-status');
+
+  if (root && approveButton && status) {
+    let state = initialState([
+      { id: 'review-1', label: 'Quarterly review' },
+      { id: 'review-2', label: 'Customer follow-up' },
+      { id: 'review-3', label: 'Policy update' },
+    ]);
+
+    const render = () => renderReview(root, approveButton, status, state);
+
+    root.addEventListener('click', (event) => {
+      const button = event.target.closest('button[data-id]');
+      if (!button || !root.contains(button)) return;
+
+      state = toggleSelection(state, button.dataset.id);
+      render();
+    });
+
+    approveButton.addEventListener('click', () => {
+      state = approveSelected(state);
+      render();
+    });
+
+    render();
+  }
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { initialState, toggleSelection, approveSelected };
+}
