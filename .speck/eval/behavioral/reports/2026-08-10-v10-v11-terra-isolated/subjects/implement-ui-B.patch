diff --git a/web/app.js b/web/app.js
index 0dda12b..80c68af 100644
--- a/web/app.js
+++ b/web/app.js
@@ -1,3 +1,94 @@
-function initialState(items) { throw new Error('not implemented'); }
-function toggleSelection(state, id) { throw new Error('not implemented'); }
-function approveSelected(state) { throw new Error('not implemented'); }
+function initialState(items) {
+  const ids = new Set();
+  const pendingItems = items.map((item) => {
+    if (ids.has(item.id)) {
+      throw new TypeError(`Duplicate item id: ${item.id}`);
+    }
+
+    ids.add(item.id);
+    return { ...item, status: 'pending', selected: false };
+  });
+
+  return { items: pendingItems, selectedIds: [] };
+}
+
+function toggleSelection(state, id) {
+  if (!state.items.some((item) => item.id === id)) {
+    return state;
+  }
+
+  const selectedIds = new Set(state.selectedIds);
+  if (selectedIds.has(id)) {
+    selectedIds.delete(id);
+  } else {
+    selectedIds.add(id);
+  }
+
+  return {
+    ...state,
+    selectedIds: [...selectedIds],
+    items: state.items.map((item) =>
+      item.id === id ? { ...item, selected: selectedIds.has(id) } : item,
+    ),
+  };
+}
+
+function approveSelected(state) {
+  if (state.selectedIds.length === 0) {
+    return state;
+  }
+
+  const selectedIds = new Set(state.selectedIds);
+  return {
+    ...state,
+    selectedIds: [],
+    items: state.items.map((item) => ({
+      ...item,
+      status: selectedIds.has(item.id) ? 'confirmed' : 'pending',
+      selected: false,
+    })),
+  };
+}
+
+function mountReview(root, approveButton, items) {
+  let state = initialState(items);
+
+  function render() {
+    root.replaceChildren(
+      ...state.items.map((item) => {
+        const button = document.createElement('button');
+        button.type = 'button';
+        button.className = 'review-item';
+        button.dataset.itemId = item.id;
+        button.setAttribute('aria-pressed', String(item.selected));
+        button.textContent = item.label || item.id;
+        button.addEventListener('click', () => {
+          state = toggleSelection(state, item.id);
+          render();
+        });
+        return button;
+      }),
+    );
+    approveButton.disabled = state.selectedIds.length === 0;
+  }
+
+  approveButton.addEventListener('click', () => {
+    state = approveSelected(state);
+    render();
+  });
+
+  render();
+  return () => state;
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { initialState, toggleSelection, approveSelected };
+}
+
+if (typeof document !== 'undefined') {
+  const root = document.querySelector('#review');
+  const approveButton = document.querySelector('#approve');
+  if (root && approveButton) {
+    mountReview(root, approveButton, window.reviewItems || []);
+  }
+}
diff --git a/web/app.test.js b/web/app.test.js
