index 0000000..abdcfd5
--- /dev/null
+++ b/web/app.test.js
@@ -0,0 +1,84 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const test = require('node:test');
+const vm = require('node:vm');
+const { initialState, toggleSelection, approveSelected } = require('./app.js');
+
+test('initialState creates pending, unselected copies without mutating input', () => {
+  const items = [{ id: 'one', label: 'First' }];
+
+  const state = initialState(items);
+
+  assert.deepEqual(state, {
+    items: [{ id: 'one', label: 'First', status: 'pending', selected: false }],
+    selectedIds: [],
+  });
+  assert.deepEqual(items, [{ id: 'one', label: 'First' }]);
+});
+
+test('initialState rejects duplicate item ids', () => {
+  assert.throws(() => initialState([{ id: 'one' }, { id: 'one' }]), /Duplicate item id/);
+});
+
+test('toggleSelection changes only a matching item and preserves its input', () => {
+  const before = initialState([{ id: 'one' }, { id: 'two' }]);
+  const after = toggleSelection(before, 'two');
+
+  assert.deepEqual(after.selectedIds, ['two']);
+  assert.equal(after.items[0].selected, false);
+  assert.equal(after.items[1].selected, true);
+  assert.deepEqual(before.selectedIds, []);
+  assert.strictEqual(toggleSelection(before, 'missing'), before);
+});
+
+test('approveSelected confirms selected items, clears selection, and preserves unselected items', () => {
+  const selected = toggleSelection(initialState([{ id: 'one' }, { id: 'two' }]), 'one');
+  const approved = approveSelected(selected);
+  const emptySelection = initialState([{ id: 'one' }]);
+
+  assert.deepEqual(approved.selectedIds, []);
+  assert.deepEqual(approved.items, [
+    { id: 'one', status: 'confirmed', selected: false },
+    { id: 'two', status: 'pending', selected: false },
+  ]);
+  assert.strictEqual(approveSelected(emptySelection), emptySelection);
+});
+
+test('browser controls expose pressed state and only enable approval after selection', () => {
+  class Element {
+    constructor() {
+      this.attributes = new Map();
+      this.children = [];
+      this.listeners = new Map();
+      this.dataset = {};
+      this.disabled = false;
+    }
+
+    setAttribute(name, value) { this.attributes.set(name, value); }
+    getAttribute(name) { return this.attributes.get(name); }
+    addEventListener(name, handler) { this.listeners.set(name, handler); }
+    replaceChildren(...children) { this.children = children; }
+    click() { this.listeners.get('click')(); }
+  }
+
+  const root = new Element();
+  const approve = new Element();
+  const document = {
+    createElement: () => new Element(),
+    querySelector: (selector) => ({ '#review': root, '#approve': approve }[selector]),
+  };
+
+  vm.runInNewContext(fs.readFileSync(require.resolve('./app.js'), 'utf8'), {
+    document,
+    window: { reviewItems: [{ id: 'one', label: 'First' }, { id: 'two', label: 'Second' }] },
+  });
+
+  assert.equal(approve.disabled, true);
+  assert.equal(root.children[0].getAttribute('aria-pressed'), 'false');
+  root.children[0].click();
+  assert.equal(root.children[0].getAttribute('aria-pressed'), 'true');
+  assert.equal(approve.disabled, false);
+  approve.click();
+  assert.equal(root.children[0].getAttribute('aria-pressed'), 'false');
+  assert.equal(approve.disabled, true);
+});
