+paths:
+  /internal/reminder-send-attempts:
+    post:
+      operationId: beginReminderSendAttempt
+      summary: Reserve one retry credit and create or return a logical send attempt.
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/BeginAttemptRequest'
+      responses:
+        '201':
+          description: A retry credit was reserved for a new attempt.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Reservation'
+        '200':
+          description: The same logical attempt was already reserved or completed; no second debit occurred.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Reservation'
+        '409':
+          description: No retry credit was available; no attempt or reservation was created.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/QuotaExhausted'
+  /internal/reminder-send-attempts/{attemptId}/outcomes:
+    post:
+      operationId: recordReminderSendOutcome
+      summary: Finalize or restore an existing retry reservation exactly once.
+      parameters:
+        - name: attemptId
+          in: path
+          required: true
+          schema:
+            type: string
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/ProviderOutcomeRequest'
+      responses:
+        '200':
+          description: The terminal outcome was applied or was a duplicate of an already terminal attempt.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Reservation'
+        '404':
+          description: No reservation exists for the supplied attempt.
+components:
+  schemas:
+    BeginAttemptRequest:
+      type: object
+      additionalProperties: false
+      required: [workspaceId, attemptId]
+      properties:
+        workspaceId:
+          type: string
+        attemptId:
+          type: string
+          description: Stable caller-generated idempotency key for one logical send attempt.
+    ProviderOutcomeRequest:
+      type: object
+      additionalProperties: false
+      required: [outcome, providerCallbackId]
+      properties:
+        outcome:
+          type: string
+          enum: [accepted, failed, timed_out, cancelled]
+        providerCallbackId:
+          type: string
+          description: Stable provider event identifier used for diagnostics and callback deduplication.
+    Reservation:
+      type: object
+      additionalProperties: false
+      required: [reservationId, workspaceId, attemptId, state]
+      properties:
+        reservationId:
+          type: string
+        workspaceId:
+          type: string
+        attemptId:
+          type: string
+        state:
+          type: string
+          enum: [reserved, finalized, restored]
+        terminalOutcome:
+          type: [string, 'null']
+          enum: [accepted, failed, timed_out, cancelled, null]
+    QuotaExhausted:
+      type: object
+      additionalProperties: false
+      required: [code]
+      properties:
+        code:
+          type: string
+          const: retry_quota_exhausted
