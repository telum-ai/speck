+++ b/tests/test_reminders.py
@@ -0,0 +1,83 @@
+"""Behavioral tests for reminder construction."""
+
+from copy import deepcopy
+from datetime import datetime, timezone
+import unittest
+
+from src.reminders import build_reminder
+
+
+NOW = datetime(2026, 8, 10, 12, 0, tzinfo=timezone.utc)
+
+
+def action(**overrides):
+    value = {
+        "confirmed": True,
+        "id": "action-42",
+        "owner": "alex",
+        "due_at": "2026-08-12T12:00:00Z",
+    }
+    value.update(overrides)
+    return value
+
+
+class BuildReminderTests(unittest.TestCase):
+    def test_unconfirmed_actions_return_none(self):
+        for confirmed in (False, None, 0, 1, "true"):
+            with self.subTest(confirmed=confirmed):
+                self.assertIsNone(build_reminder(action(confirmed=confirmed), NOW))
+
+    def test_invalid_confirmed_actions_raise_value_error(self):
+        invalid_actions = (
+            action(id=""),
+            action(owner=""),
+            action(due_at="not-a-date"),
+            action(due_at="2026-08-12T12:00:00"),
+            action(due_at="2026-08-12T13:00:00+01:00"),
+        )
+        for invalid_action in invalid_actions:
+            with self.subTest(invalid_action=invalid_action):
+                with self.assertRaises(ValueError):
+                    build_reminder(invalid_action, NOW)
+
+    def test_schedules_twenty_four_hours_before_due_time(self):
+        result = build_reminder(action(), NOW)
+
+        self.assertEqual(
+            result,
+            {
+                "id": "reminder:action-42:2026-08-12T12:00:00Z",
+                "action_id": "action-42",
+                "owner": "alex",
+                "due_at": "2026-08-12T12:00:00Z",
+                "remind_at": "2026-08-11T12:00:00Z",
+            },
+        )
+
+    def test_uses_five_minute_fallback_only_when_strictly_before_due(self):
+        result = build_reminder(action(due_at="2026-08-10T12:10:01Z"), NOW)
+        self.assertEqual(result["remind_at"], "2026-08-10T12:05:00Z")
+
+        self.assertIsNone(build_reminder(action(due_at="2026-08-10T12:05:00Z"), NOW))
+
+    def test_keeps_the_normal_reminder_when_it_is_exactly_now(self):
+        result = build_reminder(action(due_at="2026-08-11T12:00:00Z"), NOW)
+        self.assertEqual(result["remind_at"], "2026-08-10T12:00:00Z")
+
+    def test_does_not_schedule_due_or_past_actions(self):
+        self.assertIsNone(build_reminder(action(due_at="2026-08-10T12:00:00Z"), NOW))
+        self.assertIsNone(build_reminder(action(due_at="2026-08-10T11:59:59Z"), NOW))
+
+    def test_output_is_deterministic_and_does_not_mutate_input(self):
+        input_action = action(due_at="2026-08-11T12:00:00Z")
+        original = deepcopy(input_action)
+
+        first = build_reminder(input_action, NOW)
+        second = build_reminder(input_action, NOW)
+
+        self.assertEqual(first, second)
+        self.assertEqual(input_action, original)
+
+
+if __name__ == "__main__":
+    unittest.main()
