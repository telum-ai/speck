 """Reminder construction."""
 
+from datetime import datetime, timedelta, timezone
+from collections.abc import Mapping
+
+
+def _parse_utc_timestamp(value, field_name):
+    """Return a UTC datetime for an ISO-8601 UTC timestamp."""
+    if not isinstance(value, str) or not value:
+        raise ValueError(f"{field_name} must be a non-empty ISO-8601 UTC timestamp")
+
+    normalized = f"{value[:-1]}+00:00" if value.endswith("Z") else value
+    try:
+        parsed = datetime.fromisoformat(normalized)
+    except ValueError as error:
+        raise ValueError(f"{field_name} must be an ISO-8601 UTC timestamp") from error
+
+    if parsed.tzinfo is None or parsed.utcoffset() != timedelta(0):
+        raise ValueError(f"{field_name} must be an ISO-8601 UTC timestamp")
+    return parsed.astimezone(timezone.utc)
+
+
+def _format_utc(value):
+    """Serialize a UTC datetime with the contract's ``Z`` suffix."""
+    return value.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
 
 def build_reminder(action, now):
-    raise NotImplementedError
+    """Build a reminder payload for a confirmed action, when one is possible."""
+    if not isinstance(action, Mapping) or action.get("confirmed") is not True:
+        return None
+
+    action_id = action.get("id")
+    owner = action.get("owner")
+    if not isinstance(action_id, str) or not action_id:
+        raise ValueError("confirmed action requires a non-empty id")
+    if not isinstance(owner, str) or not owner:
+        raise ValueError("confirmed action requires a non-empty owner")
+
+    due_at = _parse_utc_timestamp(action.get("due_at"), "due_at")
+    now_at = (
+        _parse_utc_timestamp(now, "now")
+        if isinstance(now, str)
+        else _parse_utc_datetime(now, "now")
+    )
+    if due_at <= now_at:
+        return None
+
+    remind_at = due_at - timedelta(hours=24)
+    if remind_at < now_at:
+        fallback = now_at + timedelta(minutes=5)
+        if fallback >= due_at:
+            return None
+        remind_at = fallback
+
+    due_at_value = _format_utc(due_at)
+    return {
+        "id": f"reminder:{action_id}:{due_at_value}",
+        "action_id": action_id,
+        "owner": owner,
+        "due_at": due_at_value,
+        "remind_at": _format_utc(remind_at),
+    }
+
+
+def _parse_utc_datetime(value, field_name):
+    """Validate a timezone-aware UTC ``datetime`` supplied by the caller."""
+    if not isinstance(value, datetime):
+        raise ValueError(f"{field_name} must be a UTC datetime or ISO-8601 UTC timestamp")
+    if value.tzinfo is None or value.utcoffset() != timedelta(0):
+        raise ValueError(f"{field_name} must be a UTC datetime or ISO-8601 UTC timestamp")
+    return value.astimezone(timezone.utc)
