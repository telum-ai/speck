@@ -0,0 +1,45 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { initialState, toggleSelection, approveSelected } = require('./app.js');
+
+test('initialState creates pending, unselected copies without mutating input', () => {
+  const items = [{ id: 'one', title: 'First' }];
+  const state = initialState(items);
+
+  assert.deepEqual(state, { items: [{ id: 'one', title: 'First', status: 'pending', selected: false }] });
+  assert.deepEqual(items, [{ id: 'one', title: 'First' }]);
+  assert.notEqual(state.items[0], items[0]);
+});
+
+test('initialState rejects duplicate item ids', () => {
+  assert.throws(() => initialState([{ id: 'one' }, { id: 'one' }]), /Duplicate item id: one/);
+});
+
+test('toggleSelection changes only a matching item and leaves an unknown id unchanged', () => {
+  const state = initialState([{ id: 'one' }, { id: 'two' }]);
+  const toggled = toggleSelection(state, 'two');
+
+  assert.deepEqual(toggled.items.map(({ id, selected }) => ({ id, selected })), [
+    { id: 'one', selected: false },
+    { id: 'two', selected: true },
+  ]);
+  assert.deepEqual(state.items.map(({ id, selected }) => ({ id, selected })), [
+    { id: 'one', selected: false },
+    { id: 'two', selected: false },
+  ]);
+  assert.equal(toggleSelection(state, 'missing'), state);
+});
+
+test('approveSelected confirms exactly selected items and clears all selection', () => {
+  const pending = initialState([{ id: 'one' }, { id: 'two' }]);
+  const selected = toggleSelection(pending, 'one');
+  const approved = approveSelected(selected);
+
+  assert.deepEqual(approved.items, [
+    { id: 'one', status: 'confirmed', selected: false },
+    { id: 'two', status: 'pending', selected: false },
+  ]);
+  assert.equal(approveSelected(pending), pending);
+});
+
