@@ -1,3 +1,70 @@
-function initialState(items) { throw new Error('not implemented'); }
-function toggleSelection(state, id) { throw new Error('not implemented'); }
-function approveSelected(state) { throw new Error('not implemented'); }
+function initialState(items) {
+  const ids = new Set();
+  const nextItems = items.map((item) => {
+    if (ids.has(item.id)) {
+      throw new Error(`Duplicate item id: ${item.id}`);
+    }
+    ids.add(item.id);
+    return { ...item, status: 'pending', selected: false };
+  });
+
+  return { items: nextItems };
+}
+
+function toggleSelection(state, id) {
+  const item = state.items.find((candidate) => candidate.id === id);
+  if (!item) return state;
+
+  return {
+    ...state,
+    items: state.items.map((candidate) => (
+      candidate.id === id ? { ...candidate, selected: !candidate.selected } : candidate
+    )),
+  };
+}
+
+function approveSelected(state) {
+  if (!state.items.some((item) => item.selected)) return state;
+
+  return {
+    ...state,
+    items: state.items.map((item) => (
+      item.selected
+        ? { ...item, status: 'confirmed', selected: false }
+        : { ...item, selected: false }
+    )),
+  };
+}
+
+function renderReview(root, approveButton, state) {
+  root.replaceChildren();
+  state.items.forEach((item) => {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.dataset.reviewId = item.id;
+    button.setAttribute('aria-pressed', String(item.selected));
+    button.textContent = item.title || item.id;
+    button.addEventListener('click', () => {
+      state = toggleSelection(state, item.id);
+      renderReview(root, approveButton, state);
+    });
+    root.append(button);
+  });
+  approveButton.disabled = !state.items.some((item) => item.selected);
+  approveButton.onclick = () => {
+    state = approveSelected(state);
+    renderReview(root, approveButton, state);
+  };
+}
+
+function mountReview(items) {
+  if (typeof document === 'undefined') return;
+  const root = document.querySelector('#review');
+  const approveButton = document.querySelector('#approve');
+  if (!root || !approveButton) return;
+  renderReview(root, approveButton, initialState(items));
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { initialState, toggleSelection, approveSelected };
+}
