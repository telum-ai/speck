+version: 1
+title: Provider retry quota internal contract
+scope: reminder send-attempt accounting
+commands:
+  reserve:
+    input:
+      workspace_id: stable workspace identifier
+      attempt_id: stable reminder send-attempt identifier
+    preconditions:
+      - workspace_id identifies a quota record
+      - attempt_id is stable across retries of the same attempt
+    outcomes:
+      reserved:
+        effects:
+          - atomically decrement available_retry_credits by one
+          - create or return the reservation for workspace_id and attempt_id in reserved state
+      insufficient_credit:
+        effects:
+          - do not create a reservation
+          - do not change available_retry_credits
+      existing_reservation:
+        effects:
+          - return the existing reservation without changing balance
+  finalize:
+    input:
+      workspace_id: stable workspace identifier
+      reservation_id: durable reservation identifier
+      outcome: accepted
+    outcomes:
+      finalized:
+        precondition: reservation is reserved and belongs to workspace_id
+        effects:
+          - transition reservation from reserved to finalized
+          - do not change available_retry_credits
+      already_settled:
+        effects:
+          - return recorded terminal state
+          - do not change balance or reservation state
+  restore:
+    input:
+      workspace_id: stable workspace identifier
+      reservation_id: durable reservation identifier
+      outcome: provider_failed | timeout | cancelled
+    outcomes:
+      restored:
+        precondition: reservation is reserved and belongs to workspace_id
+        effects:
+          - atomically transition reservation from reserved to restored
+          - atomically increment available_retry_credits by one
+      already_settled:
+        effects:
+          - return recorded terminal state
+          - do not change balance or reservation state
+invariants:
+  - available_retry_credits is never negative
+  - a reservation has exactly one terminal state
+  - duplicate callbacks are idempotent
+  - finalized reservations do not return credit
+  - failed, timed-out, and cancelled reservations return credit once
