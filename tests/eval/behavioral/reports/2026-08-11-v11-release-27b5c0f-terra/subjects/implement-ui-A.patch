diff --git a/web/app.js b/web/app.js
index 0dda12b..bce2396 100644
--- a/web/app.js
+++ b/web/app.js
@@ -1,3 +1,103 @@
-function initialState(items) { throw new Error('not implemented'); }
-function toggleSelection(state, id) { throw new Error('not implemented'); }
-function approveSelected(state) { throw new Error('not implemented'); }
+function assertUniqueIds(items) {
+  const ids = new Set();
+  for (const item of items) {
+    if (ids.has(item.id)) {
+      throw new Error(`Duplicate item id: ${item.id}`);
+    }
+    ids.add(item.id);
+  }
+}
+
+function initialState(items) {
+  assertUniqueIds(items);
+  return {
+    items: items.map((item) => ({ ...item, status: 'pending', selected: false })),
+  };
+}
+
+function toggleSelection(state, id) {
+  const itemIndex = state.items.findIndex((item) => item.id === id);
+  if (itemIndex === -1) {
+    return state;
+  }
+
+  return {
+    ...state,
+    items: state.items.map((item, index) =>
+      index === itemIndex ? { ...item, selected: !item.selected } : item,
+    ),
+  };
+}
+
+function approveSelected(state) {
+  if (!state.items.some((item) => item.selected)) {
+    return state;
+  }
+
+  return {
+    ...state,
+    items: state.items.map((item) =>
+      item.selected
+        ? { ...item, status: 'confirmed', selected: false }
+        : { ...item, selected: false },
+    ),
+  };
+}
+
+function renderReview(root, approveButton, state) {
+  root.replaceChildren();
+
+  const list = document.createElement('ul');
+  list.className = 'review-list';
+  list.setAttribute('aria-label', 'Items awaiting review');
+
+  state.items.forEach((item) => {
+    const listItem = document.createElement('li');
+    listItem.className = 'review-item';
+    const toggle = document.createElement('button');
+    toggle.type = 'button';
+    toggle.className = 'review-toggle';
+    toggle.textContent = item.title || item.id;
+    toggle.setAttribute('aria-pressed', String(item.selected));
+    toggle.setAttribute('aria-label', `Select ${item.title || item.id}`);
+    toggle.addEventListener('click', () => {
+      state = toggleSelection(state, item.id);
+      renderReview(root, approveButton, state);
+    });
+
+    const status = document.createElement('span');
+    status.className = 'review-status';
+    status.textContent = item.status;
+    status.setAttribute('aria-label', `Status: ${item.status}`);
+    listItem.append(toggle, status);
+    list.append(listItem);
+  });
+
+  root.append(list);
+  approveButton.className = 'approve-button';
+  approveButton.disabled = !state.items.some((item) => item.selected);
+  approveButton.onclick = () => {
+    state = approveSelected(state);
+    renderReview(root, approveButton, state);
+  };
+}
+
+function mountReview(items) {
+  const root = document.getElementById('review');
+  const approveButton = document.getElementById('approve');
+  if (!root || !approveButton) {
+    return;
+  }
+  renderReview(root, approveButton, initialState(items));
+}
+
+const reviewState = { initialState, toggleSelection, approveSelected };
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = reviewState;
+}
+
+if (typeof window !== 'undefined') {
+  window.PulseboardReview = reviewState;
+  mountReview(window.reviewItems || []);
+}
diff --git a/web/app.test.js b/web/app.test.js
new file mode 100644
index 0000000..4470e85
--- /dev/null
+++ b/web/app.test.js
@@ -0,0 +1,51 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { initialState, toggleSelection, approveSelected } = require('./app.js');
+
+test('initialState creates pending, unselected copies without mutating inputs', () => {
+  const items = [{ id: 'one', title: 'First', status: 'draft' }];
+  const state = initialState(items);
+
+  assert.deepEqual(state, {
+    items: [{ id: 'one', title: 'First', status: 'pending', selected: false }],
+  });
+  assert.deepEqual(items, [{ id: 'one', title: 'First', status: 'draft' }]);
+  assert.notEqual(state.items[0], items[0]);
+});
+
+test('initialState rejects duplicate item ids', () => {
+  assert.throws(() => initialState([{ id: 'one' }, { id: 'one' }]), /Duplicate item id: one/);
+});
+
+test('toggleSelection changes only a matching item and preserves inputs', () => {
+  const state = initialState([{ id: 'one' }, { id: 'two' }]);
+  const toggled = toggleSelection(state, 'two');
+
+  assert.equal(toggled.items[0].selected, false);
+  assert.equal(toggled.items[1].selected, true);
+  assert.equal(state.items[1].selected, false);
+  assert.equal(toggleSelection(state, 'missing'), state);
+});
+
+test('approveSelected confirms selected items, preserves unselected statuses, and clears selection', () => {
+  const state = {
+    items: [
+      { id: 'one', status: 'pending', selected: true },
+      { id: 'two', status: 'rejected', selected: false },
+    ],
+  };
+  const approved = approveSelected(state);
+
+  assert.deepEqual(approved, {
+    items: [
+      { id: 'one', status: 'confirmed', selected: false },
+      { id: 'two', status: 'rejected', selected: false },
+    ],
+  });
+  assert.equal(state.items[0].selected, true);
+});
+
+test('approveSelected leaves an empty selection unchanged', () => {
+  const state = initialState([{ id: 'one' }]);
+  assert.equal(approveSelected(state), state);
+});
