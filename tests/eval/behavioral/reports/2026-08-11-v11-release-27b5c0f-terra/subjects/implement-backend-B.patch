@@ -0,0 +1,75 @@
+import copy
+from datetime import datetime, timezone
+import unittest
+
+from src.reminders import build_reminder
+
+
+NOW = datetime(2026, 8, 11, 12, 0, tzinfo=timezone.utc)
+
+
+class BuildReminderTests(unittest.TestCase):
+    def confirmed_action(self, **overrides):
+        action = {
+            "id": "action-42",
+            "owner": "owner-7",
+            "confirmed": True,
+            "due_at": "2026-08-13T12:00:00Z",
+        }
+        action.update(overrides)
+        return action
+
+    def test_returns_deterministic_normal_schedule_without_mutating_input(self):
+        action = self.confirmed_action()
+        original = copy.deepcopy(action)
+
+        reminder = build_reminder(action, NOW)
+
+        self.assertEqual(action, original)
+        self.assertEqual(
+            reminder,
+            {
+                "id": "reminder:action-42:2026-08-13T12:00:00Z",
+                "action_id": "action-42",
+                "owner": "owner-7",
+                "due_at": "2026-08-13T12:00:00Z",
+                "remind_at": "2026-08-12T12:00:00Z",
+            },
+        )
+
+    def test_unconfirmed_actions_return_none_before_validation(self):
+        self.assertIsNone(build_reminder({"confirmed": 1}, NOW))
+        self.assertIsNone(build_reminder({"confirmed": False}, NOW))
+
+    def test_confirmed_actions_require_id_owner_and_utc_due_at(self):
+        for action in (
+            self.confirmed_action(id=""),
+            self.confirmed_action(owner=""),
+            self.confirmed_action(due_at="not-a-date"),
+            self.confirmed_action(due_at="2026-08-13T12:00:00+02:00"),
+            self.confirmed_action(due_at="2026-08-13T12:00:00"),
+        ):
+            with self.subTest(action=action):
+                with self.assertRaises(ValueError):
+                    build_reminder(action, NOW)
+
+    def test_due_at_must_be_in_the_future(self):
+        self.assertIsNone(build_reminder(self.confirmed_action(due_at="2026-08-11T12:00:00Z"), NOW))
+        self.assertIsNone(build_reminder(self.confirmed_action(due_at="2026-08-11T11:59:59Z"), NOW))
+
+    def test_schedules_at_now_when_the_normal_time_has_not_yet_passed(self):
+        reminder = build_reminder(self.confirmed_action(due_at="2026-08-12T12:00:00Z"), NOW)
+
+        self.assertEqual(reminder["remind_at"], "2026-08-11T12:00:00Z")
+
+    def test_falls_back_to_five_minutes_after_now_when_strictly_before_due(self):
+        reminder = build_reminder(self.confirmed_action(due_at="2026-08-11T12:05:01Z"), NOW)
+
+        self.assertEqual(reminder["remind_at"], "2026-08-11T12:05:00Z")
+
+    def test_returns_none_when_fallback_is_not_strictly_before_due(self):
+        self.assertIsNone(build_reminder(self.confirmed_action(due_at="2026-08-11T12:05:00Z"), NOW))
+
+
+if __name__ == "__main__":
+    unittest.main()
