 """Reminder construction."""
 
+from datetime import datetime, timedelta, timezone
+
+
+def _parse_utc_timestamp(value):
+    """Return a UTC datetime for an ISO-8601 UTC timestamp."""
+    if not isinstance(value, str):
+        raise ValueError("due_at must be an ISO-8601 UTC timestamp")
+
+    try:
+        timestamp = datetime.fromisoformat(
+            f"{value[:-1]}+00:00" if value.endswith("Z") else value
+        )
+    except ValueError as error:
+        raise ValueError("due_at must be an ISO-8601 UTC timestamp") from error
+
+    if timestamp.tzinfo is None or timestamp.utcoffset() != timedelta(0):
+        raise ValueError("due_at must be an ISO-8601 UTC timestamp")
+
+    return timestamp.astimezone(timezone.utc)
+
+
+def _format_utc_timestamp(timestamp):
+    return timestamp.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
 
 def build_reminder(action, now):
-    raise NotImplementedError
+    """Build a deterministic reminder for a confirmed action, if one is due."""
+    if action.get("confirmed") is not True:
+        return None
+
+    action_id = action.get("id")
+    owner = action.get("owner")
+    if not action_id or not owner:
+        raise ValueError("confirmed actions require non-empty id and owner")
+
+    due_at = _parse_utc_timestamp(action.get("due_at"))
+    if due_at <= now:
+        return None
+
+    remind_at = due_at - timedelta(hours=24)
+    if remind_at < now:
+        remind_at = now + timedelta(minutes=5)
+        if remind_at >= due_at:
+            return None
+
+    due_at_text = _format_utc_timestamp(due_at)
+    return {
+        "id": f"reminder:{action_id}:{due_at_text}",
+        "action_id": action_id,
+        "owner": owner,
+        "due_at": due_at_text,
+        "remind_at": _format_utc_timestamp(remind_at),
+    }
