+"""Contract tests for reminder construction."""
+
+from copy import deepcopy
+from datetime import datetime, timedelta, timezone
+import unittest
+
+from src.reminders import build_reminder
+
+
+NOW = datetime(2026, 8, 11, 12, 0, tzinfo=timezone.utc)
+
+
+def confirmed_action(**overrides):
+    action = {
+        "id": "action-17",
+        "owner": "kjetil",
+        "confirmed": True,
+        "due_at": "2026-08-12T13:00:00Z",
+    }
+    action.update(overrides)
+    return action
+
+
+class BuildReminderTests(unittest.TestCase):
+    def test_returns_none_for_any_value_except_literal_true_without_validation(self):
+        for confirmed in (False, None, 1, "true"):
+            with self.subTest(confirmed=confirmed):
+                self.assertIsNone(build_reminder({"confirmed": confirmed}, NOW))
+
+    def test_confirmed_action_requires_non_empty_string_id_and_owner(self):
+        for field, value in (("id", None), ("id", ""), ("owner", None), ("owner", "")):
+            with self.subTest(field=field, value=value):
+                with self.assertRaises(ValueError):
+                    build_reminder(confirmed_action(**{field: value}), NOW)
+
+    def test_confirmed_action_requires_a_well_formed_utc_due_at(self):
+        for due_at in (None, "", "tomorrow", "2026-08-12T13:00:00", "2026-08-12T13:00:00+02:00"):
+            with self.subTest(due_at=due_at):
+                with self.assertRaises(ValueError):
+                    build_reminder(confirmed_action(due_at=due_at), NOW)
+
+    def test_due_at_at_or_before_now_returns_none(self):
+        self.assertIsNone(build_reminder(confirmed_action(due_at="2026-08-11T12:00:00Z"), NOW))
+        self.assertIsNone(build_reminder(confirmed_action(due_at="2026-08-11T11:59:59Z"), NOW))
+
+    def test_schedules_twenty_four_hours_before_a_distant_due_date(self):
+        reminder = build_reminder(confirmed_action(), NOW)
+
+        self.assertEqual(
+            reminder,
+            {
+                "id": "reminder:action-17:2026-08-12T13:00:00Z",
+                "action_id": "action-17",
+                "owner": "kjetil",
+                "due_at": "2026-08-12T13:00:00Z",
+                "remind_at": "2026-08-11T13:00:00Z",
+            },
+        )
+
+    def test_exactly_twenty_four_hours_uses_the_normal_schedule(self):
+        reminder = build_reminder(confirmed_action(due_at="2026-08-12T12:00:00Z"), NOW)
+
+        self.assertEqual(reminder["remind_at"], "2026-08-11T12:00:00Z")
+
+    def test_uses_five_minute_fallback_only_when_strictly_before_due_at(self):
+        reminder = build_reminder(confirmed_action(due_at="2026-08-11T12:10:00Z"), NOW)
+        self.assertEqual(reminder["remind_at"], "2026-08-11T12:05:00Z")
+
+        self.assertIsNone(build_reminder(confirmed_action(due_at="2026-08-11T12:05:00Z"), NOW))
+        immediate_due = (NOW + timedelta(minutes=5, microseconds=1)).isoformat().replace("+00:00", "Z")
+        self.assertEqual(build_reminder(confirmed_action(due_at=immediate_due), NOW)["remind_at"], "2026-08-11T12:05:00Z")
+
+    def test_normalizes_utc_offsets_to_z_and_does_not_mutate_input(self):
+        action = confirmed_action(due_at="2026-08-12T13:00:00+00:00")
+        original = deepcopy(action)
+
+        first = build_reminder(action, NOW)
+        second = build_reminder(action, NOW)
+
+        self.assertEqual(action, original)
+        self.assertEqual(first, second)
+        self.assertEqual(first["due_at"], "2026-08-12T13:00:00Z")
+
+
+if __name__ == "__main__":
+    unittest.main()
