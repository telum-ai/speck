 """Reminder construction."""
 
+from collections.abc import Mapping
+from datetime import datetime, timedelta, timezone
+
+
+def _parse_utc_timestamp(value, field):
+    """Parse an ISO-8601 timestamp and require its offset to be UTC."""
+    if not isinstance(value, str) or not value:
+        raise ValueError(f"{field} must be an ISO-8601 UTC timestamp")
+
+    try:
+        timestamp = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError as error:
+        raise ValueError(f"{field} must be an ISO-8601 UTC timestamp") from error
+
+    if timestamp.tzinfo is None or timestamp.utcoffset() != timedelta(0):
+        raise ValueError(f"{field} must be an ISO-8601 UTC timestamp")
+    return timestamp.astimezone(timezone.utc)
+
+
+def _format_utc(timestamp):
+    """Emit a normalized UTC timestamp with the contract's Z suffix."""
+    return timestamp.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
 
 def build_reminder(action, now):
-    raise NotImplementedError
+    """Build a deterministic reminder for a confirmed, future action.
+
+    The function reads its input only and returns ``None`` when no valid future
+    reminder can be scheduled.
+    """
+    if not isinstance(action, Mapping) or action.get("confirmed") is not True:
+        return None
+
+    action_id = action.get("id")
+    owner = action.get("owner")
+    if not isinstance(action_id, str) or not action_id:
+        raise ValueError("confirmed action requires a non-empty id")
+    if not isinstance(owner, str) or not owner:
+        raise ValueError("confirmed action requires a non-empty owner")
+
+    due_at = _parse_utc_timestamp(action.get("due_at"), "due_at")
+    current_time = _parse_utc_timestamp(now, "now") if isinstance(now, str) else now
+    if not isinstance(current_time, datetime) or current_time.tzinfo is None:
+        raise ValueError("now must be a timezone-aware datetime or ISO-8601 UTC timestamp")
+    current_time = current_time.astimezone(timezone.utc)
+
+    if due_at <= current_time:
+        return None
+
+    remind_at = due_at - timedelta(hours=24)
+    if remind_at < current_time:
+        remind_at = current_time + timedelta(minutes=5)
+        if remind_at >= due_at:
+            return None
+
+    due_at_text = _format_utc(due_at)
+    return {
+        "id": f"reminder:{action_id}:{due_at_text}",
+        "action_id": action_id,
+        "owner": owner,
+        "due_at": due_at_text,
+        "remind_at": _format_utc(remind_at),
+    }
