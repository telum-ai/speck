+openapi: 3.1.0
+info:
+  title: Provider retry quota internal contract
+  version: 0.1.0
+  description: >-
+    Logical internal operations for a retry-send orchestrator. These are not a
+    public HTTP API and must be mapped to the project's actual transport.
+paths:
+  /internal/reminder-retry/reservations:
+    post:
+      operationId: reserveRetryCredit
+      summary: Atomically reserve one workspace retry credit for an attempt.
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/ReserveRequest'
+      responses:
+        '200':
+          description: New or existing reservation.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ReservationResult'
+        '409':
+          description: No retry credit is available; no provider send may start.
+  /internal/reminder-retry/reservations/{attempt_id}/finalize:
+    post:
+      operationId: finalizeRetryReservation
+      summary: Record provider acceptance exactly once.
+      parameters:
+        - $ref: '#/components/parameters/AttemptId'
+      responses:
+        '200':
+          description: Persisted terminal result, including an idempotent repeat.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ReservationResult'
+  /internal/reminder-retry/reservations/{attempt_id}/restore:
+    post:
+      operationId: restoreRetryReservation
+      summary: Restore one reserved credit for a provider failure, timeout, or cancellation.
+      parameters:
+        - $ref: '#/components/parameters/AttemptId'
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/RestoreRequest'
+      responses:
+        '200':
+          description: Persisted terminal result, including an idempotent repeat.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/ReservationResult'
+components:
+  parameters:
+    AttemptId:
+      name: attempt_id
+      in: path
+      required: true
+      schema:
+        type: string
+  schemas:
+    ReserveRequest:
+      type: object
+      required: [attempt_id, workspace_id]
+      properties:
+        attempt_id:
+          type: string
+        workspace_id:
+          type: string
+    RestoreRequest:
+      type: object
+      required: [reason]
+      properties:
+        reason:
+          type: string
+          enum: [provider_failure, timeout, cancelled]
+    ReservationResult:
+      type: object
+      required: [attempt_id, workspace_id, state, idempotent]
+      properties:
+        attempt_id:
+          type: string
+        workspace_id:
+          type: string
+        state:
+          type: string
+          enum: [reserved, finalized, restored]
+        idempotent:
+          type: boolean
