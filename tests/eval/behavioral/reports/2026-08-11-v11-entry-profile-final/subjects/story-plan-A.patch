+openapi: 3.1.0
+info:
+  title: Provider retry quota service contract
+  version: 0.1.0
+  description: Storage-agnostic internal contract for an atomic workspace retry-credit reservation lifecycle.
+paths:
+  /internal/retry-credits/reservations:
+    post:
+      operationId: reserveRetryCredit
+      summary: Atomically reserve one credit for a send attempt.
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/ReserveRequest'
+      responses:
+        '200':
+          description: Existing or newly created pending reservation.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Reservation'
+        '409':
+          description: No retry credit is available for a new attempt.
+  /internal/retry-credits/reservations/{attemptId}/settlement:
+    post:
+      operationId: settleRetryCreditReservation
+      summary: Finalize or release a pending reservation exactly once.
+      parameters:
+        - name: attemptId
+          in: path
+          required: true
+          schema: { type: string }
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: '#/components/schemas/SettlementRequest'
+      responses:
+        '200':
+          description: Recorded terminal reservation; duplicate settlements return the recorded state without another balance mutation.
+          content:
+            application/json:
+              schema:
+                $ref: '#/components/schemas/Reservation'
+        '404':
+          description: Attempt does not belong to the supplied workspace or has no reservation.
+components:
+  schemas:
+    ReserveRequest:
+      type: object
+      required: [workspaceId, attemptId]
+      properties:
+        workspaceId: { type: string }
+        attemptId: { type: string }
+    SettlementRequest:
+      type: object
+      required: [workspaceId, outcome]
+      properties:
+        workspaceId: { type: string }
+        outcome:
+          type: string
+          enum: [accepted, provider_failed, timed_out, cancelled, rolled_back]
+    Reservation:
+      type: object
+      required: [reservationId, workspaceId, attemptId, state]
+      properties:
+        reservationId: { type: string }
+        workspaceId: { type: string }
+        attemptId: { type: string }
+        state:
+          type: string
+          enum: [pending, finalized, released]
+        releaseReason:
+          type: [string, 'null']
+          enum: [provider_failed, timed_out, cancelled, rolled_back, null]
