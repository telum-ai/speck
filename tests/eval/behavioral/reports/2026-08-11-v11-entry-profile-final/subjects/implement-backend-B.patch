 """Reminder construction."""
 
+from collections.abc import Mapping
+from datetime import datetime, timedelta, timezone
+
+
+_UTC = timezone.utc
+
 
 def build_reminder(action, now):
-    raise NotImplementedError
+    """Build a deterministic reminder payload for one confirmed action.
+
+    Ineligible actions return ``None`` before field validation. Confirmed
+    actions must carry non-empty identifiers and a UTC ISO-8601 due time.
+    """
+    if not isinstance(action, Mapping) or action.get("confirmed") is not True:
+        return None
+
+    action_id = _required_value(action, "id")
+    owner = _required_value(action, "owner")
+    due_at = _parse_utc_timestamp(_required_value(action, "due_at"))
+    current_time = _as_utc(now, field_name="now")
+
+    if due_at <= current_time:
+        return None
+
+    remind_at = due_at - timedelta(hours=24)
+    if remind_at < current_time:
+        remind_at = current_time + timedelta(minutes=5)
+        if remind_at >= due_at:
+            return None
+
+    due_at_text = _format_utc(due_at)
+    return {
+        "id": f"reminder:{action_id}:{due_at_text}",
+        "action_id": action_id,
+        "owner": owner,
+        "due_at": due_at_text,
+        "remind_at": _format_utc(remind_at),
+    }
+
+
+def _required_value(action, field_name):
+    """Return a required non-blank action value or raise ``ValueError``."""
+    value = action.get(field_name)
+    if value is None or value == "" or (isinstance(value, str) and not value.strip()):
+        raise ValueError(f"confirmed action requires a non-empty {field_name}")
+    return value
+
+
+def _parse_utc_timestamp(value):
+    """Parse an ISO-8601 timestamp whose offset is explicitly UTC."""
+    if not isinstance(value, str):
+        raise ValueError("confirmed action requires an ISO-8601 UTC due_at")
+
+    try:
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError as error:
+        raise ValueError("confirmed action requires an ISO-8601 UTC due_at") from error
+
+    return _as_utc(parsed, field_name="due_at")
+
+
+def _as_utc(value, *, field_name):
+    """Require an aware zero-offset datetime and return its UTC equivalent."""
+    if not isinstance(value, datetime) or value.tzinfo is None or value.utcoffset() != timedelta(0):
+        raise ValueError(f"{field_name} must be an ISO-8601 UTC timestamp")
+    return value.astimezone(_UTC)
+
+
+def _format_utc(value):
+    """Serialize an aware UTC datetime with the conventional ``Z`` suffix."""
+    return value.astimezone(_UTC).isoformat().replace("+00:00", "Z")
