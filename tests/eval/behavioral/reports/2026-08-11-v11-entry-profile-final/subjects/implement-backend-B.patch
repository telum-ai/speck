+"""Tests for reminder construction."""
+
+from copy import deepcopy
+from datetime import datetime, timezone
+import unittest
+
+from src.reminders import build_reminder
+
+
+UTC = timezone.utc
+NOW = datetime(2026, 8, 11, 12, 0, tzinfo=UTC)
+
+
+def action(**overrides):
+    value = {
+        "confirmed": True,
+        "id": "action-42",
+        "owner": "alex",
+        "due_at": "2026-08-13T12:00:00Z",
+    }
+    value.update(overrides)
+    return value
+
+
+class BuildReminderTests(unittest.TestCase):
+    def test_returns_canonical_deterministic_payload_without_mutating_input(self):
+        source = action(due_at="2026-08-13T12:00:00+00:00")
+        original = deepcopy(source)
+
+        first = build_reminder(source, NOW)
+        second = build_reminder(source, NOW)
+
+        expected = {
+            "id": "reminder:action-42:2026-08-13T12:00:00Z",
+            "action_id": "action-42",
+            "owner": "alex",
+            "due_at": "2026-08-13T12:00:00Z",
+            "remind_at": "2026-08-12T12:00:00Z",
+        }
+        self.assertEqual(first, expected)
+        self.assertEqual(second, expected)
+        self.assertEqual(source, original)
+
+    def test_returns_none_unless_confirmed_is_strictly_true(self):
+        self.assertIsNone(build_reminder(action(confirmed=False), NOW))
+        self.assertIsNone(build_reminder(action(confirmed=1), NOW))
+        self.assertIsNone(build_reminder(action(confirmed=None), NOW))
+
+    def test_confirmed_actions_require_non_empty_id_and_owner(self):
+        for invalid in (action(id=""), action(id="  "), action(owner=""), action(owner="  ")):
+            with self.subTest(invalid=invalid):
+                with self.assertRaises(ValueError):
+                    build_reminder(invalid, NOW)
+
+    def test_confirmed_actions_require_an_iso_utc_due_time(self):
+        for due_at in ("not-a-date", "2026-08-13T12:00:00", "2026-08-13T12:00:00+02:00", ""):
+            with self.subTest(due_at=due_at):
+                with self.assertRaises(ValueError):
+                    build_reminder(action(due_at=due_at), NOW)
+
+    def test_returns_none_when_due_at_is_not_in_the_future(self):
+        self.assertIsNone(build_reminder(action(due_at="2026-08-11T12:00:00Z"), NOW))
+        self.assertIsNone(build_reminder(action(due_at="2026-08-11T11:59:59Z"), NOW))
+
+    def test_uses_five_minute_fallback_when_normal_reminder_has_passed(self):
+        reminder = build_reminder(action(due_at="2026-08-11T12:10:00Z"), NOW)
+        self.assertEqual(reminder["remind_at"], "2026-08-11T12:05:00Z")
+
+    def test_keeps_normal_reminder_when_it_is_exactly_now(self):
+        reminder = build_reminder(action(due_at="2026-08-12T12:00:00Z"), NOW)
+        self.assertEqual(reminder["remind_at"], "2026-08-11T12:00:00Z")
+
+    def test_returns_none_when_fallback_is_not_strictly_before_due_at(self):
+        self.assertIsNone(build_reminder(action(due_at="2026-08-11T12:05:00Z"), NOW))
+
+
+if __name__ == "__main__":
+    unittest.main()
