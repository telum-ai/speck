-function initialState(items) { throw new Error('not implemented'); }
-function toggleSelection(state, id) { throw new Error('not implemented'); }
-function approveSelected(state) { throw new Error('not implemented'); }
+(function reviewStateModule(global) {
+  'use strict';
+
+  function assertUniqueIds(items) {
+    const ids = new Set();
+    for (const item of items) {
+      if (ids.has(item.id)) {
+        throw new Error(`Duplicate item id: ${item.id}`);
+      }
+      ids.add(item.id);
+    }
+  }
+
+  function initialState(items) {
+    if (!Array.isArray(items)) {
+      throw new TypeError('items must be an array');
+    }
+    assertUniqueIds(items);
+    return {
+      items: items.map((item) => ({ ...item, status: 'pending', selected: false })),
+    };
+  }
+
+  function toggleSelection(state, id) {
+    const index = state.items.findIndex((item) => item.id === id);
+    if (index === -1) {
+      return state;
+    }
+
+    return {
+      ...state,
+      items: state.items.map((item, itemIndex) => (
+        itemIndex === index ? { ...item, selected: !item.selected } : item
+      )),
+    };
+  }
+
+  function approveSelected(state) {
+    if (!state.items.some((item) => item.selected)) {
+      return state;
+    }
+
+    return {
+      ...state,
+      items: state.items.map((item) => (
+        item.selected
+          ? { ...item, status: 'confirmed', selected: false }
+          : item
+      )),
+    };
+  }
+
+  function itemLabel(item) {
+    return item.title || item.name || String(item.id);
+  }
+
+  function renderReview(root, state, onChange) {
+    root.replaceChildren();
+    const list = document.createElement('ul');
+    list.setAttribute('aria-label', 'Items awaiting review');
+
+    state.items.forEach((item) => {
+      const row = document.createElement('li');
+      const button = document.createElement('button');
+      button.type = 'button';
+      button.textContent = itemLabel(item);
+      button.setAttribute('aria-pressed', String(item.selected));
+      button.setAttribute('aria-label', `Select ${itemLabel(item)}`);
+      button.addEventListener('click', () => onChange(toggleSelection(state, item.id)));
+      row.append(button);
+
+      const status = document.createElement('span');
+      status.textContent = item.status;
+      status.setAttribute('aria-label', `Status: ${item.status}`);
+      row.append(' ', status);
+      list.append(row);
+    });
+
+    root.append(list);
+  }
+
+  function mountReview(root, approveButton, items) {
+    let state = initialState(items);
+
+    function update(nextState) {
+      state = nextState;
+      approveButton.disabled = !state.items.some((item) => item.selected);
+      renderReview(root, state, update);
+    }
+
+    approveButton.addEventListener('click', () => update(approveSelected(state)));
+    update(state);
+    return () => state;
+  }
+
+  const api = { initialState, toggleSelection, approveSelected, mountReview };
+
+  if (typeof module !== 'undefined' && module.exports) {
+    module.exports = api;
+  }
+
+  if (global && global.document) {
+    global.ReviewState = api;
+    const root = global.document.getElementById('review');
+    const approveButton = global.document.getElementById('approve');
+    if (root && approveButton) {
+      mountReview(root, approveButton, global.reviewItems || []);
+    }
+  }
+}(typeof window === 'undefined' ? undefined : window));
diff --git a/web/app.test.js b/web/app.test.js
new file mode 100644
index 0000000..965e063
--- /dev/null
+++ b/web/app.test.js
@@ -0,0 +1,117 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const {
+  initialState,
+  toggleSelection,
+  approveSelected,
+  mountReview,
+} = require('./app.js');
+
+class FakeElement {
+  constructor(tagName) {
+    this.tagName = tagName;
+    this.children = [];
+    this.attributes = {};
+    this.listeners = {};
+    this.disabled = false;
+    this.textContent = '';
+  }
+
+  setAttribute(name, value) {
+    this.attributes[name] = String(value);
+  }
+
+  append(...children) {
+    this.children.push(...children);
+  }
+
+  replaceChildren(...children) {
+    this.children = children;
+  }
+
+  addEventListener(type, listener) {
+    this.listeners[type] = listener;
+  }
+
+  click() {
+    this.listeners.click();
+  }
+}
+
+test('initialState creates pending, unselected items without mutating input', () => {
+  const items = [{ id: 'a', title: 'First' }, { id: 'b', status: 'draft' }];
+
+  const state = initialState(items);
+
+  assert.deepEqual(state, {
+    items: [
+      { id: 'a', title: 'First', status: 'pending', selected: false },
+      { id: 'b', status: 'pending', selected: false },
+    ],
+  });
+  assert.deepEqual(items, [{ id: 'a', title: 'First' }, { id: 'b', status: 'draft' }]);
+});
+
+test('initialState rejects duplicate item ids', () => {
+  assert.throws(() => initialState([{ id: 'same' }, { id: 'same' }]), /Duplicate item id: same/);
+});
+
+test('toggleSelection changes only the matching item and returns the same state for unknown ids', () => {
+  const state = initialState([{ id: 'a' }, { id: 'b' }]);
+  const toggled = toggleSelection(state, 'b');
+
+  assert.deepEqual(toggled, {
+    items: [
+      { id: 'a', status: 'pending', selected: false },
+      { id: 'b', status: 'pending', selected: true },
+    ],
+  });
+  assert.equal(toggleSelection(state, 'missing'), state);
+  assert.equal(state.items[1].selected, false);
+});
+
+test('approveSelected confirms only selected items and clears all selection', () => {
+  const selected = {
+    items: [
+      { id: 'a', status: 'pending', selected: true },
+      { id: 'b', status: 'draft', selected: false },
+    ],
+  };
+  const approved = approveSelected(selected);
+
+  assert.deepEqual(approved, {
+    items: [
+      { id: 'a', status: 'confirmed', selected: false },
+      { id: 'b', status: 'draft', selected: false },
+    ],
+  });
+  assert.equal(selected.items[0].status, 'pending');
+  const emptySelection = initialState([{ id: 'a' }]);
+  assert.equal(approveSelected(emptySelection), emptySelection);
+});
+
+test('mounted controls expose selection state and disable approval until selection exists', () => {
+  const previousDocument = global.document;
+  global.document = { createElement: (tagName) => new FakeElement(tagName) };
+  const root = new FakeElement('section');
+  const approveButton = new FakeElement('button');
+
+  const getState = mountReview(root, approveButton, [{ id: 'a', title: 'First' }]);
+  const selectionButton = root.children[0].children[0].children[0];
+
+  assert.equal(selectionButton.attributes['aria-pressed'], 'false');
+  assert.equal(approveButton.disabled, true);
+
+  selectionButton.click();
+  const selectedButton = root.children[0].children[0].children[0];
+  assert.equal(selectedButton.attributes['aria-pressed'], 'true');
+  assert.equal(approveButton.disabled, false);
+
+  approveButton.click();
+  assert.equal(getState().items[0].status, 'confirmed');
+  assert.equal(getState().items[0].selected, false);
+  assert.equal(approveButton.disabled, true);
+
+  global.document = previousDocument;
+});
