+"""Contract tests for reminder construction."""
+
+from datetime import datetime, timezone
+import unittest
+
+from src.reminders import build_reminder
+
+
+NOW = datetime(2026, 8, 11, 12, 0, tzinfo=timezone.utc)
+
+
+def confirmed_action(*, due_at, action_id="action-1", owner="owner-1"):
+    return {
+        "confirmed": True,
+        "id": action_id,
+        "owner": owner,
+        "due_at": due_at,
+    }
+
+
+class BuildReminderTests(unittest.TestCase):
+    def test_unconfirmed_action_is_ignored_without_validating_other_fields(self):
+        self.assertIsNone(build_reminder({"confirmed": 1}, NOW))
+
+    def test_confirmed_action_requires_id_owner_and_utc_iso_due_at(self):
+        for action in (
+            confirmed_action(due_at="2026-08-12T12:00:00Z", action_id=""),
+            confirmed_action(due_at="2026-08-12T12:00:00Z", owner="   "),
+            confirmed_action(due_at="not-a-date"),
+            confirmed_action(due_at="2026-08-12T12:00:00+01:00"),
+        ):
+            with self.subTest(action=action):
+                with self.assertRaises(ValueError):
+                    build_reminder(action, NOW)
+
+    def test_future_due_action_schedules_twenty_four_hours_before_due_at(self):
+        action = confirmed_action(due_at="2026-08-13T12:00:00+00:00")
+
+        reminder = build_reminder(action, NOW)
+
+        self.assertEqual(
+            reminder,
+            {
+                "id": "reminder:action-1:2026-08-13T12:00:00Z",
+                "action_id": "action-1",
+                "owner": "owner-1",
+                "due_at": "2026-08-13T12:00:00Z",
+                "remind_at": "2026-08-12T12:00:00Z",
+            },
+        )
+        self.assertEqual(action["due_at"], "2026-08-13T12:00:00+00:00")
+
+    def test_past_standard_time_uses_five_minute_fallback_when_still_before_due(self):
+        action = confirmed_action(due_at="2026-08-11T12:06:00Z")
+
+        reminder = build_reminder(action, NOW)
+
+        self.assertEqual(reminder["remind_at"], "2026-08-11T12:05:00Z")
+
+    def test_fallback_must_be_strictly_before_due_at(self):
+        action = confirmed_action(due_at="2026-08-11T12:05:00Z")
+
+        self.assertIsNone(build_reminder(action, NOW))
+
+    def test_due_at_must_be_strictly_future(self):
+        action = confirmed_action(due_at="2026-08-11T12:00:00Z")
+
+        self.assertIsNone(build_reminder(action, NOW))
+
+    def test_exact_twenty_four_hour_boundary_keeps_standard_reminder_time(self):
+        action = confirmed_action(due_at="2026-08-12T12:00:00Z")
+
+        self.assertEqual(build_reminder(action, NOW)["remind_at"], "2026-08-11T12:00:00Z")
+
+
+if __name__ == "__main__":
+    unittest.main()
