 """Reminder construction."""
 
+from collections.abc import Mapping
+from datetime import datetime, timedelta, timezone
+
+
+def _parse_utc_timestamp(value):
+    """Return an ISO-8601 UTC timestamp as an aware ``datetime``."""
+    if not isinstance(value, str):
+        raise ValueError("due_at must be an ISO-8601 UTC timestamp")
+
+    try:
+        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
+    except ValueError as error:
+        raise ValueError("due_at must be an ISO-8601 UTC timestamp") from error
+
+    if parsed.tzinfo is None or parsed.utcoffset() != timedelta(0):
+        raise ValueError("due_at must be an ISO-8601 UTC timestamp")
+
+    return parsed.astimezone(timezone.utc)
+
+
+def _format_utc_timestamp(value):
+    return value.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")
+
 
 def build_reminder(action, now):
-    raise NotImplementedError
+    """Build a deterministic reminder payload for a confirmed action.
+
+    Confirmed actions are deliberately validated before scheduling.  Other
+    actions are ignored, allowing callers to pass incomplete drafts safely.
+    """
+    if not isinstance(action, Mapping) or action.get("confirmed") is not True:
+        return None
+
+    action_id = action.get("id")
+    owner = action.get("owner")
+    if not isinstance(action_id, str) or not action_id.strip():
+        raise ValueError("confirmed action requires a non-empty id")
+    if not isinstance(owner, str) or not owner.strip():
+        raise ValueError("confirmed action requires a non-empty owner")
+
+    due_at = _parse_utc_timestamp(action.get("due_at"))
+    if not isinstance(now, datetime) or now.tzinfo is None:
+        raise ValueError("now must be a timezone-aware datetime")
+    now_utc = now.astimezone(timezone.utc)
+
+    if due_at <= now_utc:
+        return None
+
+    remind_at = due_at - timedelta(hours=24)
+    if remind_at < now_utc:
+        remind_at = now_utc + timedelta(minutes=5)
+        if remind_at >= due_at:
+            return None
+
+    due_at_text = _format_utc_timestamp(due_at)
+    return {
+        "id": f"reminder:{action_id}:{due_at_text}",
+        "action_id": action_id,
+        "owner": owner,
+        "due_at": due_at_text,
+        "remind_at": _format_utc_timestamp(remind_at),
+    }
