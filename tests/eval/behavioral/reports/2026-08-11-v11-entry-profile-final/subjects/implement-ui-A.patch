+  return {
+    items: items.map((item) => {
+      if (ids.has(item.id)) {
+        throw new Error(`duplicate item id: ${item.id}`);
+      }
+
+      ids.add(item.id);
+      return { ...item, status: 'pending', selected: false };
+    }),
+  };
+}
+
+function toggleSelection(state, id) {
+  const item = state.items.find((candidate) => candidate.id === id);
+
+  if (!item) {
+    return state;
+  }
+
+  return {
+    ...state,
+    items: state.items.map((candidate) => (
+      candidate.id === id
+        ? { ...candidate, selected: !candidate.selected }
+        : candidate
+    )),
+  };
+}
+
+function approveSelected(state) {
+  if (!state.items.some((item) => item.selected)) {
+    return state;
+  }
+
+  return {
+    ...state,
+    items: state.items.map((item) => (
+      item.selected
+        ? { ...item, status: 'confirmed', selected: false }
+        : item
+    )),
+  };
+}
+
+function renderReview(container, approveButton, state, onStateChange) {
+  container.replaceChildren();
+  container.className = 'review-list';
+
+  state.items.forEach((item) => {
+    const button = document.createElement('button');
+    button.type = 'button';
+    button.className = item.selected ? 'review-item review-item--selected' : 'review-item';
+    button.textContent = item.label || String(item.id);
+    button.setAttribute('aria-pressed', String(item.selected));
+    button.addEventListener('click', () => onStateChange(toggleSelection(state, item.id)));
+    container.append(button);
+  });
+
+  approveButton.disabled = !state.items.some((item) => item.selected);
+  approveButton.onclick = () => onStateChange(approveSelected(state));
+}
+
+function mountReview(items) {
+  const container = document.getElementById('review');
+  const approveButton = document.getElementById('approve');
+
+  if (!container || !approveButton) {
+    return;
+  }
+
+  let state = initialState(items);
+  const update = (nextState) => {
+    state = nextState;
+    renderReview(container, approveButton, state, update);
+  };
+
+  update(state);
+}
+
+if (typeof module !== 'undefined' && module.exports) {
+  module.exports = { initialState, toggleSelection, approveSelected };
+}
+
+if (typeof window !== 'undefined' && typeof document !== 'undefined') {
+  window.PulseboardReview = { initialState, toggleSelection, approveSelected, mountReview };
+  document.addEventListener('DOMContentLoaded', () => {
+    mountReview(window.reviewItems || []);
+  });
+}
