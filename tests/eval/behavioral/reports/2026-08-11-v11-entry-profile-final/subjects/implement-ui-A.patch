@@ -0,0 +1,93 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const test = require('node:test');
+const vm = require('node:vm');
+
+const {
+  initialState,
+  toggleSelection,
+  approveSelected,
+} = require('../web/app.js');
+
+test('initialState makes a new pending, unselected state without mutating input', () => {
+  const items = [{ id: 'a', status: 'draft', label: 'First' }, { id: 'b' }];
+
+  const state = initialState(items);
+
+  assert.deepEqual(state, {
+    items: [
+      { id: 'a', status: 'pending', label: 'First', selected: false },
+      { id: 'b', status: 'pending', selected: false },
+    ],
+  });
+  assert.deepEqual(items, [{ id: 'a', status: 'draft', label: 'First' }, { id: 'b' }]);
+  assert.notStrictEqual(state.items, items);
+  assert.notStrictEqual(state.items[0], items[0]);
+});
+
+test('initialState rejects duplicate item ids', () => {
+  assert.throws(() => initialState([{ id: 'a' }, { id: 'a' }]), /duplicate item id: a/i);
+});
+
+test('toggleSelection changes only a matching item and preserves unknown-id identity', () => {
+  const state = initialState([{ id: 'a' }, { id: 'b' }]);
+  const selected = toggleSelection(state, 'b');
+
+  assert.deepEqual(selected.items, [
+    { id: 'a', status: 'pending', selected: false },
+    { id: 'b', status: 'pending', selected: true },
+  ]);
+  assert.strictEqual(selected.items[0], state.items[0]);
+  assert.strictEqual(toggleSelection(state, 'missing'), state);
+});
+
+test('approveSelected confirms only selected items and clears all selections', () => {
+  const initial = initialState([{ id: 'a' }, { id: 'b' }, { id: 'c', status: 'draft' }]);
+  const selected = toggleSelection(toggleSelection(initial, 'a'), 'c');
+  const approved = approveSelected(selected);
+
+  assert.deepEqual(approved.items, [
+    { id: 'a', status: 'confirmed', selected: false },
+    { id: 'b', status: 'pending', selected: false },
+    { id: 'c', status: 'confirmed', selected: false },
+  ]);
+  assert.strictEqual(approveSelected(initial), initial);
+});
+
+test('browser controls render truthful selection state and prevent empty approval', () => {
+  const source = fs.readFileSync(require.resolve('../web/app.js'), 'utf8');
+  const events = new Map();
+  const review = {
+    children: [],
+    replaceChildren(...children) { this.children = children; },
+    append(child) { this.children.push(child); },
+  };
+  const approve = { disabled: false, onclick: null };
+  const document = {
+    addEventListener(type, listener) { events.set(type, listener); },
+    createElement() {
+      return {
+        attributes: new Map(),
+        listeners: new Map(),
+        setAttribute(name, value) { this.attributes.set(name, value); },
+        addEventListener(type, listener) { this.listeners.set(type, listener); },
+      };
+    },
+    getElementById(id) { return id === 'review' ? review : approve; },
+  };
+  const window = { reviewItems: [{ id: 'a', label: 'First' }] };
+
+  vm.runInNewContext(source, { document, module: { exports: {} }, window });
+  events.get('DOMContentLoaded')();
+
+  assert.equal(review.children[0].attributes.get('aria-pressed'), 'false');
+  assert.equal(approve.disabled, true);
+
+  review.children[0].listeners.get('click')();
+  assert.equal(review.children[0].attributes.get('aria-pressed'), 'true');
+  assert.equal(approve.disabled, false);
+
+  approve.onclick();
+  assert.equal(review.children[0].attributes.get('aria-pressed'), 'false');
+  assert.equal(approve.disabled, true);
+});
